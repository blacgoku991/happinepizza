---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HoursPanel from '../components/HoursPanel.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref, mapsUrl, fullAddress } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
const d = 0.012;
const bbox = [SITE.geo.lng - d * 1.6, SITE.geo.lat - d, SITE.geo.lng + d * 1.6, SITE.geo.lat + d].join(',');
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${SITE.geo.lat},${SITE.geo.lng}`;
---

<Base
  title={`Contact & accès – ${SITE.address.city}`}
  description={`Contactez ${SITE.name} au ${SITE.phone}. Adresse : ${fullAddress}. Horaires, plan d'accès et commande par téléphone.`}
  jsonLd={[
    breadcrumbSchema(crumbs),
    { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Contact ${SITE.name}`, url: `${SITE.url}/contact/`, about: { '@id': `${SITE.url}/#restaurant` } },
  ]}
>
  <PageHero crumbs={crumbs} eyebrow="Contact" title="Passez nous voir," titleAccent="ou appelez-nous." intro="Commandes, questions, grandes tablées : notre équipe vous répond pendant les heures d'ouverture." photo="ambiance-planche" />

  <section class="sec--tight">
    <div class="wrap grid">
      <div class="cards">
        <a href={telHref} class="cc cc--phone rv">
          <span class="cc__ic"><Icon name="phone" stroke={2} /></span>
          <span class="cc__l">Téléphone · commandes</span>
          <strong class="cc__v">{SITE.phone}</strong>
          <span class="cc__cta">Appeler <Icon name="arrow" size={18} stroke={2} /></span>
        </a>
        <a href={mapsUrl} target="_blank" rel="noopener" class="cc rv" style="--d:1">
          <span class="cc__ic"><Icon name="pin" /></span>
          <span class="cc__l">Adresse</span>
          <address class="cc__v">{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}</address>
          <span class="cc__cta">Itinéraire <Icon name="arrow-up-right" size={18} /></span>
        </a>
        <div class="cc rv" style="--d:2">
          <span class="cc__l">Services</span>
          <ul class="cc__list">{SITE.services.map((s) => <li><Icon name="check" size={17} stroke={2} /> {s}</li>)}</ul>
          <span class="cc__l">Paiements acceptés</span>
          <ul class="cc__list">{SITE.payments.map((p) => <li><Icon name="check" size={17} stroke={2} /> {p}</li>)}</ul>
        </div>
      </div>
      <div class="side">
        <div class="rv"><HoursPanel /></div>
        <div class="map rv">
          <iframe title={`Plan d'accès — ${SITE.name}`} src={osm} loading="lazy" referrerpolicy="no-referrer"></iframe>
          <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-ember btn-sm map__btn">Ouvrir dans Google Maps <Icon name="arrow-up-right" size={16} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 20px;
    align-items: start;
  }
  .cards,
  .side {
    display: grid;
    gap: 16px;
  }
  .cc {
    display: grid;
    gap: 8px;
    padding: 28px;
    border-radius: 28px;
    border: 1px solid var(--line);
    background: var(--card);
    transition: border-color 0.3s, transform 0.5s var(--ease);
  }
  a.cc:hover {
    border-color: rgba(255, 140, 70, 0.4);
    transform: translateY(-3px);
  }
  .cc--phone {
    border-color: rgba(255, 140, 70, 0.35);
    background: radial-gradient(80% 120% at 100% 0%, rgba(255, 90, 31, 0.3), transparent 60%), var(--s1);
  }
  .cc__ic {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--grad-btn);
    color: #170903;
    margin-bottom: 8px;
  }
  .cc__l {
    font: 700 10.5px/1 var(--sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .cc__v {
    font: 700 clamp(24px, 3vw, 36px) / 1.1 var(--display);
    letter-spacing: -0.035em;
    font-style: normal;
  }
  .cc__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-weight: 700;
    color: var(--ember-2);
  }
  .cc__list {
    display: grid;
    gap: 8px;
    margin: 6px 0 14px;
  }
  .cc__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .cc__list :global(.i) {
    color: var(--ember-2);
  }
  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--s1);
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: invert(0.92) hue-rotate(180deg) saturate(0.6) brightness(0.9);
  }
  .map__btn {
    position: absolute;
    left: 16px;
    bottom: 16px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
