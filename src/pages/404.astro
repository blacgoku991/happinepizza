---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';
import { pizzaArt } from '../lib/pizzaArt';
import { PIZZAS } from '../data/menu';
---

<Base title="Page introuvable" description={`Cette page n'existe pas ou plus. Retrouvez toute la carte ${SITE.name}, pizzeria à ${SITE.address.city}.`} noindex>
  <section class="nf">
    <div class="container nf__inner">
      <div class="nf__big" aria-hidden="true">
        <span>4</span>
        <span class="nf__pizza" set:html={pizzaArt(PIZZAS[0])}></span>
        <span>4</span>
      </div>
      <h1 class="h-2">Oups, cette part a disparu&nbsp;!</h1>
      <p class="lead muted">La page que vous cherchez n'existe pas ou a été déplacée. Mais la carte, elle, est bien là.</p>
      <div class="nf__ctas">
        <a href="/carte/" class="btn btn--lg">Voir la carte <Icon name="arrow" /></a>
        <a href="/" class="btn btn--lg btn--ghost">Accueil</a>
        <a href={telHref} class="btn btn--lg btn--ghost"><Icon name="phone" /> {SITE.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: var(--header-h);
  }
  .nf__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 24px;
    padding-block: 60px;
  }
  .nf__big {
    display: flex;
    align-items: center;
    gap: 0.05em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(8rem, 28vw, 18rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--tomato);
  }
  .nf__pizza {
    width: 0.78em;
    animation: nfspin 8s linear infinite;
  }
  .nf__pizza :global(svg) {
    width: 100%;
    clip-path: polygon(50% 50%, 50% 0, 100% 0, 100% 100%, 0 100%, 0 0, 30% 0);
  }
  @keyframes nfspin {
    to {
      rotate: 360deg;
    }
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
