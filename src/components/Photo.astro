---
/**
 * Photo optimisée (AVIF + WebP, srcset responsive, lazy-loading).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | undefined;
  alt: string;
  /** Attribut sizes (ex. "(min-width: 900px) 33vw, 100vw"). */
  sizes?: string;
  widths?: number[];
  /** true pour les images au-dessus de la ligne de flottaison (LCP). */
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  /** Point focal CSS object-position. */
  position?: string;
}

const { src, alt, sizes = '100vw', widths, priority = false, class: className, pictureClass, position } = Astro.props;
const w = src ? (widths ?? [480, 800, 1200, 1600, 2000]).filter((x) => x <= src.width) : [];
if (src && (!w.length || w[w.length - 1] < src.width)) w.push(Math.min(src.width, 2400));
---

{
  src && (
    <Picture
      src={src}
      alt={alt}
      widths={w}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      class={className}
      style={position ? `object-position:${position}` : undefined}
      pictureAttributes={{ class: pictureClass }}
    />
  )
}
