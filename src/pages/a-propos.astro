---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';
import { PIZZAS, pizzaBySlug } from '../data/menu';
import { breadcrumbSchema } from '../lib/schema';
import { pizzaArt } from '../lib/pizzaArt';

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Notre histoire', path: '/a-propos/' },
];
const art = pizzaArt(pizzaBySlug('chevre-miel') ?? PIZZAS[0]);

const values = [
  { icon: 'wheat', title: 'La pâte, notre fierté', text: 'Pétrie chaque jour sur place, elle repose le temps qu’il faut pour être légère, moelleuse et croustillante.' },
  { icon: 'leaf', title: 'Des produits choisis', text: 'Mozzarella fondante, légumes frais, viandes et fromages sélectionnés : on ne transige pas sur la qualité.' },
  { icon: 'flame', title: 'Des recettes pour tous', text: 'Des grands classiques italiens aux créations gourmandes comme la Burger ou la Chilly, il y en a pour chaque envie.' },
  { icon: 'heart', title: 'L’accueil avant tout', text: 'Sur place, à emporter ou en livraison, notre équipe vous reçoit avec le sourire. Happiness, ce n’est pas qu’un nom.' },
] as const;
---

<Base
  title="Notre histoire – pizzeria artisanale"
  description={`${SITE.name}, pizzeria artisanale à ${SITE.address.city} : pâte fraîche du jour, ingrédients soigneusement sélectionnés et recettes gourmandes.`}
  type="article"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Notre histoire"
    title="Une pizzeria de quartier,"
    titleAccent=" une passion XXL."
    intro={`Chez ${SITE.name}, nous mettons tout notre savoir-faire et notre passion dans la création de pizzas délicieuses, préparées avec des ingrédients soigneusement sélectionnés.`}
  >
    <div slot="art" class="about-art" data-speed="-0.3" set:html={art} />
  </PageHero>

  <section class="section on-light">
    <div class="container about-story">
      <div class="about-story__big" data-reveal>
        <p>
          « Que vous soyez amateur de <span class="serif">recettes classiques</span> ou en quête de <span class="serif text-tomato"
            >saveurs originales</span
          >, notre carte saura vous séduire. »
        </p>
      </div>
      <div class="about-story__text">
        <p data-reveal>
          Installée au cœur de {SITE.address.city}, au {SITE.address.street}, {SITE.name} est née d'une idée simple : proposer des pizzas
          artisanales au goût authentique, préparées chaque jour avec des ingrédients frais et de qualité, à des prix accessibles à tous.
        </p>
        <p data-reveal>
          Chaque pizza est façonnée à la commande : la pâte est étalée à la main, garnie généreusement puis cuite jusqu'à ce que la croûte soit
          dorée et le fromage parfaitement fondu. Chez nous, chaque bouchée est une explosion de saveurs !
        </p>
        <p data-reveal>
          Au-delà des pizzas, découvrez nos pâtes gratinées, salades fraîches, paninis croustillants et desserts gourmands — à déguster sur
          place, à emporter ou livrés chez vous à {SITE.address.city} et alentours.
        </p>
        <div class="about-story__ctas" data-reveal>
          <a href="/carte/" class="btn">Découvrir la carte <Icon name="arrow" /></a>
          <a href={telHref} class="btn btn--ghost"><Icon name="phone" /> {SITE.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nos engagements</span>
        <h2 class="h-1" data-split>Ce qui nous rend <span class="serif text-saffron">heureux.</span></h2>
      </div>
      <ul class="about-values">
        {
          values.map((v, i) => (
            <li class="tilt" data-reveal data-delay={i * 0.08}>
              <span class="tilt__glare" />
              <span class="about-values__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="about-values__icon tilt__pop">
                <Icon name={v.icon} size={28} />
              </span>
              <h3 class="h-3">{v.title}</h3>
              <p class="muted">{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .about-art {
    width: min(100%, 460px);
    filter: drop-shadow(0 40px 40px rgba(0, 0, 0, 0.5));
    animation: aboutspin 70s linear infinite;
  }
  @keyframes aboutspin {
    to {
      rotate: 360deg;
    }
  }
  .about-story {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .about-story__big p {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .about-story__text {
    display: grid;
    gap: 20px;
    font-size: 1.08rem;
    color: var(--muted-on-light);
  }
  .about-story__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .about-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .about-values li {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 32px 26px;
    border-radius: var(--radius-lg);
    background: linear-gradient(170deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--line-dark);
  }
  .about-values__num {
    position: absolute;
    top: 22px;
    right: 24px;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--muted-on-dark);
    opacity: 0.6;
  }
  .about-values__icon {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 18px;
    background: var(--tomato);
    margin-bottom: 12px;
  }
  @media (max-width: 1000px) {
    .about-values {
      grid-template-columns: repeat(2, 1fr);
    }
    .about-story {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .about-values {
      grid-template-columns: 1fr;
    }
  }
</style>
