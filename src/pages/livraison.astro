---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Hours from '../components/Hours.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';
import { FAQS } from '../data/faq';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const city = SITE.address.city;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Livraison', path: '/livraison/' },
];
const faqs = FAQS.filter((f) => /livr|command|paiement|emporter/i.test(f.q));

const deliverySchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Livraison de pizzas à domicile',
  provider: { '@id': `${SITE.url}/#restaurant` },
  areaServed: SITE.zones.map((z) => ({ '@type': 'City', name: z })),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: `Livraison gratuite dans un rayon de ${SITE.delivery.radiusKm} km, minimum de commande ${SITE.delivery.minOrder} €`,
  },
};
---

<Base
  title={`Livraison de pizzas à ${city}`}
  description={`Livraison de pizzas gratuite à ${city}, ${SITE.zones.slice(1, 3).join(', ')}… dans un rayon de ${SITE.delivery.radiusKm} km. Minimum ${SITE.delivery.minOrder} €. ☎ ${SITE.phone}`}
  jsonLd={[breadcrumbSchema(crumbs), deliverySchema, faqSchema(faqs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Livraison"
    title="Vos pizzas livrées"
    titleAccent=" bien chaudes."
    intro={`Livraison gratuite à ${city} et dans les communes voisines, dans un rayon de ${SITE.delivery.radiusKm} km, dès ${SITE.delivery.minOrder} € de commande.`}
  >
    <div class="liv-ctas" data-reveal data-delay="0.3">
      <a href={telHref} class="btn btn--lg" data-magnetic><Icon name="phone" /> {SITE.phone}</a>
      <a href="/carte/" class="btn btn--lg btn--ghost">Voir la carte <Icon name="arrow" /></a>
    </div>
  </PageHero>

  <section class="section--tight on-light">
    <div class="container">
      <ul class="liv-kpis">
        <li data-reveal>
          <Icon name="bike" size={34} />
          <strong>Gratuite</strong>
          <span>dans un rayon de {SITE.delivery.radiusKm} km</span>
        </li>
        <li data-reveal data-delay="0.08">
          <Icon name="bag" size={34} />
          <strong>{SITE.delivery.minOrder} €</strong>
          <span>minimum de commande</span>
        </li>
        <li data-reveal data-delay="0.16">
          <Icon name="clock" size={34} />
          <strong>7j/7</strong>
          <span>midi et soir</span>
        </li>
        <li data-reveal data-delay="0.24">
          <Icon name="card" size={34} />
          <strong>CB · Espèces</strong>
          <span>titres-restaurant acceptés</span>
        </li>
      </ul>

      <div class="liv-zones">
        <div class="liv-zones__text">
          <span class="eyebrow">Communes livrées</span>
          <h2 class="h-2" data-split>Nous livrons <span class="serif">près de chez vous</span></h2>
          <p class="muted" data-reveal>
            Depuis notre pizzeria du {SITE.address.street}, nous livrons {city} et les villes voisines. Votre commune n'apparaît pas ?
            Appelez-nous au <a href={telHref}>{SITE.phone}</a>, nous vous dirons si nous pouvons vous livrer.
          </p>
        </div>
        <ul class="liv-towns">
          {
            SITE.zones.map((z, i) => (
              <li data-reveal data-delay={(i % 4) * 0.05}>
                <h3>Livraison pizza {z}</h3>
                <p>{i === 0 ? 'Notre ville — livraison express' : `Livraison gratuite depuis ${city}`}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container liv-bottom">
      <div>
        <span class="eyebrow">Horaires de livraison</span>
        <h2 class="h-2" data-split>Midi <span class="serif text-saffron">&</span> soir</h2>
        <p class="muted liv-bottom__p" data-reveal>Commandez pendant nos heures d'ouverture, en livraison ou à emporter.</p>
        <div data-reveal><Hours /></div>
      </div>
      <div>
        <span class="eyebrow">Questions fréquentes</span>
        <h2 class="h-2 liv-bottom__faq-title" data-split>Bon à savoir</h2>
        <Faq items={faqs} dark />
      </div>
    </div>
  </section>
</Base>

<style>
  .liv-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .liv-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .liv-kpis li {
    display: grid;
    gap: 6px;
    padding: 28px 24px;
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 30px 60px -44px rgba(60, 20, 0, 0.45);
  }
  .liv-kpis :global(svg) {
    color: var(--tomato);
    margin-bottom: 10px;
  }
  .liv-kpis strong {
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .liv-kpis span {
    color: var(--muted-on-light);
    font-size: 0.93rem;
  }
  .liv-zones {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(64px, 8vw, 110px);
  }
  .liv-zones__text {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .liv-zones__text a {
    color: var(--tomato-2);
    font-weight: 700;
  }
  .liv-towns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .liv-towns li {
    padding: 18px 20px;
    border-radius: var(--radius);
    background: #fff;
    border-left: 4px solid var(--tomato);
  }
  .liv-towns li:first-child {
    background: var(--ink);
    color: var(--cream);
    border-color: var(--saffron);
  }
  .liv-towns h3 {
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .liv-towns p {
    font-size: 0.85rem;
    color: var(--muted-on-light);
    margin-top: 4px;
  }
  .liv-towns li:first-child p {
    color: var(--muted-on-dark);
  }
  .liv-bottom {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: start;
  }
  .liv-bottom > div {
    display: grid;
    gap: 18px;
  }
  .liv-bottom__faq-title {
    margin-bottom: 8px;
  }
  @media (max-width: 1000px) {
    .liv-kpis {
      grid-template-columns: repeat(2, 1fr);
    }
    .liv-zones,
    .liv-bottom {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .liv-towns {
      grid-template-columns: 1fr;
    }
    .liv-kpis {
      gap: 10px;
    }
    .liv-kpis li {
      padding: 20px 16px;
    }
    .liv-kpis strong {
      font-size: 1.35rem;
    }
  }
</style>
