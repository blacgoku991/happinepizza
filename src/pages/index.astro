---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PizzaCard from '../components/PizzaCard.astro';
import ItemCard from '../components/ItemCard.astro';
import Faq from '../components/Faq.astro';
import { SITE, telHref, mapsUrl, formatPrice } from '../data/site';
import { PIZZAS, CATEGORIES, MENUS, pizzaBySlug, minPrice } from '../data/menu';
import { cutout, photo } from '../lib/photos';
import { faqSchema } from '../lib/schema';
import { FAQS } from '../data/faq';

const title = `Pizzeria à ${SITE.address.city} – Livraison | ${SITE.name}`;
const description = `Pizzeria artisanale à ${SITE.address.city} : pizzas à pâte fraîche, pâtes, salades, desserts. Livraison gratuite ${SITE.delivery.radiusKm} km, à emporter, sur place. ☎ ${SITE.phone}`;

const cut = async (k: string, w = 1000) => (await getImage({ src: cutout(k)!, width: w, format: 'webp', quality: 82 })).src;
const hero = await cut('supreme', 1100);
const stackImgs = [await cut('pepperoni', 700), await cut('legumes', 700), await cut('supreme', 700)];
const sunImg = await cut('pepperoni', 1100);

const signatures = ['reine', 'burger', 'chevre-miel', 'bresilienne'].map((s) => pizzaBySlug(s)!);
const sigLabels = ["L'incontournable", 'Coup de cœur', 'Douce & salée', 'Relevée'];
const pates = CATEGORIES.find((c) => c.slug === 'pates')!;
const desserts = CATEGORIES.find((c) => c.slug === 'desserts')!;
const combos = [MENUS.find((m) => m.slug === 'menu-ambiance')!, MENUS.find((m) => m.slug === 'menu-duo')!];
const from = Math.min(...PIZZAS.map(minPrice));
const fmt = (t: string) => t.replace(':', 'h');
const edges = ['#2a1206', '#3a1a09', '#4d240d', '#633012', '#7a3e18', '#91501f', '#a8622a', '#b9723a'];
---

<Base title={title} description={description} rawTitle jsonLd={[faqSchema(FAQS)]}>
  <!-- ============ HERO + SAVOIR-FAIRE (scène 3D collante) ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="stage-track" aria-hidden="true">
      <div class="stage" data-stage>
        <div class="stage__bg"></div>
        <div class="pz" data-pz>
          <div class="pz__glow" data-pz-glow></div>
          <div class="pz__shadow" data-pz-shadow></div>
          <div class="pz__tilt" data-pz-tilt>
            <div class="pz__rings" data-pz-rings>
              <svg viewBox="0 0 1000 1000">
                <defs><linearGradient id="g-arc" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFD49A"></stop><stop offset=".5" stop-color="#FF7A2E"></stop><stop offset="1" stop-color="#FF5A1F" stop-opacity="0"></stop></linearGradient></defs>
                <circle cx="500" cy="500" r="318" fill="none" stroke="rgba(255,226,204,.10)" stroke-width="1.2"></circle>
                <circle cx="500" cy="500" r="372" fill="none" stroke="rgba(255,226,204,.07)" stroke-width="1" stroke-dasharray="2 9"></circle>
                <circle cx="500" cy="500" r="430" fill="none" stroke="rgba(255,226,204,.05)" stroke-width="1"></circle>
                <circle cx="500" cy="500" r="496" fill="none" stroke="rgba(255,226,204,.035)" stroke-width="1"></circle>
                <path d="M500 182 A318 318 0 0 1 800 395" fill="none" stroke="url(#g-arc)" stroke-width="2.4" stroke-linecap="round"></path>
                <circle cx="500" cy="182" r="4" fill="#FFD49A"></circle>
              </svg>
            </div>
            <div class="pz__spin" data-pz-spin>
              {edges.map((c, i) => <i class="pz__edge" style={`transform:translateZ(${-15 + i * 2}px);background:${c}`} />)}
              <img src={hero} alt="" style="transform:translateZ(-.6px);filter:brightness(.75)" width="1100" height="1100" />
              <img src={hero} alt="" width="1100" height="1100" fetchpriority="high" />
              <span class="hot" data-hot="1" style="--x:7%;--y:45%"><b>01</b></span>
              <span class="hot" data-hot="2" style="--x:39%;--y:40%"><b>02</b></span>
              <span class="hot" data-hot="3" style="--x:57%;--y:57%"><b>03</b></span>
              <span class="hot" data-hot="4" style="--x:66%;--y:92%"><b>04</b></span>
            </div>
            <div class="pz__light"></div>
          </div>
          <div class="pz__tag" data-pz-tag>
            <span class="pz__ring">dès</span>
            <span><small>Junior · Senior · Méga</small><b>{formatPrice(from).replace(' €', '')} <span>€</span></b></span>
          </div>
        </div>
        <canvas class="sparks" data-sparks></canvas>
      </div>
    </div>

    <div class="hero__screen wrap">
      <div class="hero__content" data-hero-content>
        <span class="kicker"><i></i>Pizzeria artisanale · {SITE.address.city}</span>
        <h1 id="hero-title" class="h1 hero__title">
          <span class="sr-only">{SITE.name}, pizzeria à {SITE.address.city} — </span>
          <span>Le bonheur</span>
          <em class="grad">sort du four.</em>
        </h1>
        <p class="lead">
          Pâte fraîche pétrie sur place, garnitures généreuses jusqu'au bord, cuisson minute. <strong>Livrée chez vous, à emporter ou sur place.</strong>
        </p>
        <div class="ctas">
          <a class="btn btn-ember" href="/carte/">Voir la carte <Icon name="arrow" stroke={2} /></a>
          <a class="btn btn-glass" href={telHref}><span class="dot"><Icon name="phone" /></span><span>Appeler<span class="hide-m">&nbsp;· {SITE.phone}</span></span></a>
        </div>
      </div>
      <ul class="trust" data-trust>
        <li class="chip"><span class="ic"><Icon name="scooter" /></span><div><b>Livraison offerte</b><span>jusqu'à {SITE.delivery.radiusKm} km · dès {SITE.delivery.minOrder} €</span></div></li>
        <li class="chip"><span class="ic"><Icon name="clock" /></span><div><b>Ouvert 7j/7</b><span>midi &amp; soir</span></div></li>
        <li class="chip"><span class="ic"><Icon name="store" /></span><div><b>Sur place &amp; à emporter</b><span>{SITE.address.street.replace('avenue', 'av.')}</span></div></li>
      </ul>
      <div class="scroll-cue" aria-hidden="true" data-cue>Défiler</div>
    </div>

    <div class="story wrap">
      <div class="story__copy">
        <span class="eyebrow">Le savoir-faire</span>
        <h2 class="h2">Généreuse<em class="grad block">jusqu'au bord.</em></h2>
        <p class="lead story__lead">Une vraie pizza se juge sur trois choses&nbsp;: la pâte, la cuisson et la générosité. Chez Happiness, on ne transige sur aucune.</p>
        <ol class="legend" data-legend>
          <li data-hot="1"><span class="n">01</span><b>Pâte fraîche du jour</b><p>Pétrie sur place, reposée, étirée à la main.</p></li>
          <li data-hot="2"><span class="n">02</span><b>Sauce &amp; mozzarella</b><p>Sauce tomate onctueuse, mozzarella qui file.</p></li>
          <li data-hot="3"><span class="n">03</span><b>Garnitures généreuses</b><p>Jusqu'au bord, pour que chaque part compte.</p></li>
          <li data-hot="4"><span class="n">04</span><b>Cuisson minute</b><p>Croustillante dehors, moelleuse dedans.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ BANDEAU ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="mq">
      {
        [0, 1].map(() => (
          <div class="mq__g">
            <span>Pâte fraîche du jour</span><i /><em>livraison offerte</em><i /><span>Junior · Senior · Méga</span><i /><em>ouvert 7j/7</em><i />
            <span>2 achetées = la 3<sup>e</sup> offerte</span><i /><em>midi &amp; soir</em><i />
          </div>
        ))
      }
    </div>
  </div>

  <!-- ============ OFFRE ============ -->
  <section class="sec offer" id="offre" aria-labelledby="offer-title">
    <div class="wrap">
      <div class="offer__panel rv">
        <div class="offer__num" aria-hidden="true">3</div>
        <div class="offer__copy">
          <span class="eyebrow">L'offre Happiness</span>
          <h2 id="offer-title" class="h2 offer__title"><span class="nw">2 achetées,</span><em class="grad block">la 3<sup>e</sup> offerte.</em></h2>
          <p class="lead">Commandez deux pizzas, la troisième est pour nous&nbsp;: la moins chère des trois vous est offerte — en livraison, à emporter ou sur place.</p>
          <ul class="conds">
            <li><Icon name="check" size={16} stroke={2.2} />Pizzas Senior &amp; Méga</li>
            <li><Icon name="check" size={16} stroke={2.2} />Livraison, emporter, sur place</li>
            <li class="x"><Icon name="x" size={16} stroke={2.2} />Hors Margherita</li>
          </ul>
          <div class="ctas">
            <a class="btn btn-ember" href="/carte/pizzas/">J'en profite <Icon name="arrow" stroke={2} /></a>
            <a class="btn btn-glass" href={telHref}><span class="dot"><Icon name="phone" /></span>Commander par téléphone</a>
          </div>
        </div>
        <div class="offer__visual" data-offer aria-hidden="true">
          <div class="stack" data-stack>
            {
              stackImgs.map((src, i) => (
                <div class="dw">
                  <div class="disc">
                    {i === 2 && <div class="disc__em" />}
                    <div class="disc__sh" />
                    <img src={src} alt="" style="transform:translateZ(-8px);filter:brightness(.25) sepia(.3)" />
                    <img src={src} alt="" style="transform:translateZ(-6px);filter:brightness(.4) sepia(.3)" />
                    <img src={src} alt="" style="transform:translateZ(-4px);filter:brightness(.55) sepia(.2)" />
                    <img src={src} alt="" style="transform:translateZ(-2px);filter:brightness(.72)" />
                    <img src={src} alt="" style="filter:saturate(1.08) contrast(1.04)" loading="lazy" />
                    <div class="disc__lt" />
                  </div>
                  <span class:list={['dtag', { 'dtag--l': i === 1, 'dtag--hot': i === 2 }]}>
                    <i>{i + 1}</i>
                    {i === 0 ? 'Une pizza' : i === 1 ? 'Deux pizzas' : <span>La 3<sup>e</sup> offerte</span>}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SIGNATURES ============ -->
  <section class="sec sig" aria-labelledby="sig-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">La carte</span>
          <h2 id="sig-title" class="h2">Nos pizzas<em class="grad block">signatures.</em></h2>
        </div>
        <div class="side">
          Trois tailles, un même soin&nbsp;: Junior pour les petites faims, Senior pour soi, Méga pour partager.<br />
          <a class="link-arrow" href="/carte/pizzas/">Voir les {PIZZAS.length} pizzas <Icon name="arrow" /></a>
        </div>
      </div>
      <ul class="cards">
        {signatures.map((p, i) => <li class="rv" style={`--d:${i}`}><PizzaCard pizza={p} label={sigLabels[i]} /></li>)}
      </ul>
    </div>
  </section>

  <!-- ============ CINÉMA ============ -->
  <section class="cine" data-cine aria-labelledby="cine-title">
    <div class="cine__media" data-cine-media>
      <Photo src={photo('ambiance-four')} alt="Pizza sortant d'un four à bois en flammes" sizes="100vw" class="cine__img" />
    </div>
    <div class="wrap cine__copy">
      <span class="eyebrow rv">Fait maison</span>
      <h2 id="cine-title" class="h2 rv" style="--d:1">Pétrie sur place,<em class="grad block">cuite minute.</em></h2>
      <p class="lead rv" style="--d:2">Une pâte qui prend le temps de reposer, un four qui ne refroidit jamais, et des pizzas qui sortent brûlantes, dorées, prêtes à partager.</p>
      <div class="stats rv" style="--d:3">
        <div class="stat"><b>3 <em>tailles</em></b><span>Junior · Senior · Méga</span></div>
        <div class="stat"><b>{PIZZAS.length} <em>recettes</em></b><span>De la Reine à la Chilly</span></div>
        <div class="stat"><b>7<em>j</em>/7</b><span>Midi &amp; soir</span></div>
      </div>
    </div>
  </section>

  <!-- ============ MENUS, PÂTES, DESSERTS ============ -->
  <section class="sec" aria-labelledby="menus-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Au-delà des pizzas</span>
          <h2 id="menus-title" class="h2">Menus, pâtes<em class="grad block">&amp; douceurs.</em></h2>
        </div>
        <div class="side">
          Des formules pensées pour partager, des pâtes gratinées et des desserts pour finir en beauté.<br />
          <a class="link-arrow" href="/carte/">Toute la carte <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="menu-grid">
        <ul class="combos">
          {combos.map((m, i) => <li class="rv" style={`--d:${i}`}><ItemCard item={m} category="menus" variant="combo" /></li>)}
        </ul>
        <div class="lists rv" style="--d:1">
          <div>
            <h3 class="list__h"><a href="/carte/pates/">Pâtes</a> <small>Gratinées</small></h3>
            {pates.items.map((it) => <ItemCard item={it} category="pates" headingLevel="h3" />)}
          </div>
          <div>
            <h3 class="list__h"><a href="/carte/desserts/">Desserts</a> <small>Gourmands</small></h3>
            {desserts.items.slice(0, 3).map((it) => <ItemCard item={it} category="desserts" headingLevel="h3" />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LIVRAISON & HORAIRES ============ -->
  <section class="sec" id="livraison" style="padding-top:0" aria-labelledby="liv-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Livraison &amp; horaires</span>
          <h2 id="liv-title" class="h2">On vous livre,<em class="grad block">c'est offert.</em></h2>
        </div>
        <div class="side">Livraison gratuite dans un rayon de {SITE.delivery.radiusKm} km autour de {SITE.address.city}, dès {SITE.delivery.minOrder} € de commande.</div>
      </div>
      <div class="deliv">
        <div class="panel rv">
          <div class="radius">
            <div class="radar" aria-hidden="true">
              <div class="radar__sweep"></div>
              <svg viewBox="0 0 300 300">
                <defs><radialGradient id="g-zone" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#FF6A25" stop-opacity=".22"></stop><stop offset=".7" stop-color="#FF5A1F" stop-opacity=".07"></stop><stop offset="1" stop-color="#FF5A1F" stop-opacity="0"></stop></radialGradient></defs>
                <circle cx="150" cy="150" r="104" fill="url(#g-zone)"></circle>
                <circle cx="150" cy="150" r="26" fill="none" stroke="rgba(255,226,204,.12)"></circle>
                <circle cx="150" cy="150" r="52" fill="none" stroke="rgba(255,226,204,.10)"></circle>
                <circle cx="150" cy="150" r="78" fill="none" stroke="rgba(255,226,204,.09)"></circle>
                <circle cx="150" cy="150" r="104" fill="none" stroke="#FF7A2E" stroke-width="1.4" stroke-dasharray="3 5"></circle>
                <circle cx="150" cy="150" r="140" fill="none" stroke="rgba(255,226,204,.05)"></circle>
                <path d="M150 40v220M40 150h220" stroke="rgba(255,226,204,.06)"></path>
                <g font-family="Manrope, sans-serif" font-size="8.5" font-weight="700" fill="rgba(246,239,231,.42)" text-anchor="middle"><text x="176" y="163">2</text><text x="202" y="163">4</text><text x="228" y="163">6</text></g>
                <circle cx="223.5" cy="76.5" r="3.5" fill="#FF8A3D"></circle>
                <rect x="230" y="56" width="50" height="22" rx="11" fill="#FF5A1F"></rect>
                <text x="255" y="71" text-anchor="middle" font-family="Manrope, sans-serif" font-size="11" font-weight="800" fill="#170903">{SITE.delivery.radiusKm} km</text>
                <circle cx="150" cy="150" r="14" fill="rgba(255,90,31,.18)"><animate attributeName="r" values="8;22;8" dur="2.6s" repeatCount="indefinite"></animate><animate attributeName="opacity" values="1;0;1" dur="2.6s" repeatCount="indefinite"></animate></circle>
                <circle cx="150" cy="150" r="6" fill="#FFE2B8" stroke="#FF5A1F" stroke-width="3"></circle>
              </svg>
            </div>
            <div>
              <h3 class="panel__t">Livraison <em>offerte</em></h3>
              <div class="facts">
                <div class="fact"><span class="ic"><Icon name="scooter" /></span><div><b>Gratuite jusqu'à {SITE.delivery.radiusKm} km</b><span>Autour de {SITE.address.city}</span></div></div>
                <div class="fact"><span class="ic"><Icon name="euro" /></span><div><b>Dès {SITE.delivery.minOrder} € d'achat</b><span>Minimum pour être livré</span></div></div>
                <div class="fact"><span class="ic"><Icon name="card" /></span><div><b>CB, espèces, titres-resto</b><span>Paiement à la livraison ou sur place</span></div></div>
              </div>
            </div>
          </div>
          <div class="zones">
            <h4>Communes livrées</h4>
            <ul>{SITE.zones.map((z, i) => <li class:list={{ me: i === 0 }}>{z}</li>)}</ul>
          </div>
        </div>
        <div class="panel rv" style="--d:1" data-hours data-schedule={JSON.stringify(SITE.hours.map((d) => d.slots))}>
          <div class="panel__head"><h3 class="panel__t">Horaires</h3><span class="status" data-status><i></i><span>Ouvert 7j/7</span></span></div>
          <ul class="hours">
            {
              SITE.hours.map((d, i) => (
                <li data-day={i}>
                  <span>{d.day}</span>
                  <span class="sl">{d.slots.length ? d.slots.map(([a, b]) => <i>{`${fmt(a)} – ${fmt(b)}`}</i>) : <i>Fermé</i>}</span>
                </li>
              ))
            }
          </ul>
          <div class="addr">
            <p><b>{SITE.address.street}</b>{SITE.address.postalCode} {SITE.address.city}</p>
            <a class="btn btn-glass btn-sm" href={mapsUrl} target="_blank" rel="noopener"><Icon name="pin" />Itinéraire</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec" style="padding-top:0" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div>
        <span class="eyebrow">Questions fréquentes</span>
        <h2 id="faq-title" class="h2">Bon<em class="grad block">à savoir.</em></h2>
        <p class="lead">Une autre question&nbsp;? Appelez-nous au <a href={telHref}><strong>{SITE.phone}</strong></a>.</p>
      </div>
      <div class="rv"><Faq items={FAQS} /></div>
    </div>
  </section>

  <!-- ============ APPEL FINAL ============ -->
  <section class="final" data-final aria-labelledby="final-title">
    <div class="wrap">
      <span class="eyebrow final__eb">Une petite faim&nbsp;?</span>
      <h2 id="final-title" class="h2">Le four est chaud, <em class="grad">il n'attend que vous.</em></h2>
      <a class="bigtel" href={telHref}>{SITE.phone}</a>
      <p class="final__sub">Commandez par téléphone — livraison offerte jusqu'à {SITE.delivery.radiusKm} km, ou retrait sur place.</p>
      <div class="ctas final__ctas">
        <a class="btn btn-ember" href={telHref}><Icon name="phone" stroke={2} />Appeler maintenant</a>
        <a class="btn btn-glass" href="/carte/">Voir la carte</a>
      </div>
    </div>
    <div class="sun" aria-hidden="true">
      <div class="sun__glow"></div>
      <div class="sun__tilt">
        <div class="sun__disc" data-sun>
          <img src={sunImg} alt="" style="transform:translateZ(-12px);filter:brightness(.2) sepia(.4)" loading="lazy" />
          <img src={sunImg} alt="" style="transform:translateZ(-8px);filter:brightness(.4) sepia(.3)" loading="lazy" />
          <img src={sunImg} alt="" style="transform:translateZ(-4px);filter:brightness(.65) sepia(.15)" loading="lazy" />
          <img src={sunImg} alt="" style="filter:saturate(1.05) contrast(1.05)" loading="lazy" />
        </div>
        <div class="sun__shade"></div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
  }
  .stage-track {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .stage {
    position: sticky;
    top: 0;
    height: var(--vh, 100vh);
    overflow: clip;
  }
  .stage__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 60% at 72% 118%, rgba(255, 78, 18, 0.2), transparent 62%),
      radial-gradient(50% 50% at 8% 0%, rgba(255, 150, 80, 0.05), transparent 70%),
      linear-gradient(180deg, #0c0907 0%, #0a0706 100%);
  }
  .stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    background: linear-gradient(180deg, transparent, var(--bg));
    z-index: 5;
  }
  .sparks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
  }
  .pz {
    --size: min(49vw, 720px, 78vh);
    position: absolute;
    left: 72.5%;
    top: 54%;
    width: var(--size);
    height: var(--size);
    perspective: 1800px;
    transform: translate(-50%, -50%);
    will-change: transform;
    z-index: 2;
  }
  .pz__glow {
    position: absolute;
    inset: -48%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 150, 70, 0.62), rgba(255, 92, 28, 0.3) 38%, rgba(255, 64, 12, 0.1) 62%, transparent 80%);
    opacity: 0.85;
  }
  .pz__shadow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.6) 55%, transparent);
    filter: blur(26px);
  }
  .pz__tilt {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(56deg);
  }
  .pz__rings {
    position: absolute;
    inset: -34%;
    transform: translateZ(-60px);
  }
  .pz__rings svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .pz__spin {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .pz__spin img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: circle(49.2%);
    user-select: none;
  }
  .pz__edge {
    position: absolute;
    inset: 0.9%;
    border-radius: 50%;
  }
  .pz__light {
    position: absolute;
    inset: 0.8%;
    border-radius: 50%;
    transform: translateZ(1.5px);
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 228, 196, 0.2), transparent 42%),
      radial-gradient(circle at 72% 86%, rgba(24, 6, 0, 0.42), transparent 52%);
    box-shadow:
      inset 0 3px 2px -1px rgba(255, 214, 170, 0.28),
      inset 0 -10px 24px -6px rgba(0, 0, 0, 0.45);
  }
  .hot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    transform: translateZ(3px);
    opacity: var(--hot, 0);
    border-radius: 50%;
    background: radial-gradient(circle, transparent 30%, rgba(10, 6, 4, 0.35) 31%);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 236, 220, 0.85),
      0 6px 24px rgba(0, 0, 0, 0.5);
  }
  .hot::before {
    content: '';
    position: absolute;
    inset: 21px;
    border-radius: 50%;
    background: #fff4e6;
    box-shadow:
      0 0 0 4px rgba(255, 90, 31, 0.85),
      0 0 24px 8px rgba(255, 110, 40, 0.8);
  }
  .hot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 190, 140, 0.9);
    animation: ping 2.6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }
  .hot:global(.hl) {
    box-shadow:
      inset 0 0 0 2px var(--gold),
      0 0 40px 6px rgba(255, 110, 40, 0.6);
  }
  .hot b {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 40px;
    height: 26px;
    margin: -13px 0 0 -20px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(14, 9, 7, 0.72);
    border: 1px solid rgba(255, 200, 160, 0.35);
    font: italic 400 16px/1 var(--serif);
    color: var(--gold);
    transform: rotateZ(calc(var(--rz, 0deg) * -1)) translateY(-46px);
  }
  @keyframes ping {
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  .pz__tag {
    position: absolute;
    right: -3%;
    top: 4%;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 18px 10px 10px;
    border-radius: 18px;
    background: rgba(20, 14, 11, 0.55);
    border: 1px solid var(--line-2);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.8);
  }
  .pz__ring {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: radial-gradient(circle, rgba(255, 120, 50, 0.35), rgba(255, 90, 31, 0.08));
    border: 1px solid rgba(255, 140, 70, 0.4);
    font: italic 400 20px/1 var(--serif);
    color: var(--gold);
  }
  .pz__tag small {
    display: block;
    font: 700 10px/1 var(--sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .pz__tag b {
    font: 700 24px/1 var(--display);
    letter-spacing: -0.04em;
  }
  .pz__tag b span {
    color: var(--gold);
  }
  .hero__screen {
    position: relative;
    z-index: 6;
    min-height: var(--vh, 100vh);
    display: flex;
    flex-direction: column;
    padding-top: var(--hdr);
  }
  .hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 700px;
    padding: 28px 0 24px;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    align-self: flex-start;
    padding: 8px 16px 8px 10px;
    border-radius: 999px;
    background: rgba(255, 240, 228, 0.04);
    border: 1px solid var(--line);
    font: 600 12.5px/1 var(--sans);
    letter-spacing: 0.04em;
    color: #d8cabd;
  }
  .kicker i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ember);
    box-shadow:
      0 0 0 4px rgba(255, 90, 31, 0.18),
      0 0 14px 2px rgba(255, 90, 31, 0.9);
  }
  .hero__title {
    margin-top: 30px;
  }
  .hero__title > span:not(.sr-only) {
    display: block;
  }
  .hero__title em {
    display: block;
    font-size: 1.2em;
    line-height: 0.96;
    margin-top: 0.02em;
    filter: drop-shadow(0 0 34px rgba(255, 90, 31, 0.28));
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0 0 34px;
  }
  .scroll-cue {
    position: absolute;
    right: var(--gutter);
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 14px;
    font: 700 10.5px/1 var(--sans);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--dim);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .scroll-cue::after {
    content: '';
    width: 1px;
    height: 64px;
    background: linear-gradient(180deg, transparent, var(--ember-2));
    animation: cue 2.2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
    }
    60% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .story {
    position: relative;
    z-index: 6;
    min-height: var(--vh, 100vh);
    display: flex;
    align-items: center;
    padding: calc(var(--hdr) + 20px) 0 60px;
  }
  .story__copy {
    max-width: 520px;
  }
  .legend {
    margin-top: 34px;
    border-top: 1px solid var(--line);
  }
  .legend li {
    display: grid;
    grid-template-columns: 54px 1fr;
    column-gap: 10px;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
  }
  .legend li:hover b {
    color: var(--gold);
  }
  .legend .n {
    grid-row: span 2;
    font: italic 400 28px/1 var(--serif);
    color: var(--ember-2);
    padding-top: 2px;
  }
  .legend b {
    font: 600 18px/1.25 var(--display);
    letter-spacing: -0.015em;
    transition: color 0.3s;
  }
  .legend p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.5;
  }

  /* ---------- BANDEAU ---------- */
  .marquee {
    position: relative;
    z-index: 2;
    border-block: 1px solid var(--line);
    padding: 26px 0;
    overflow: clip;
    background: linear-gradient(180deg, var(--bg), #0c0907);
  }
  .mq {
    display: flex;
    width: max-content;
    animation: mq 46s linear infinite;
  }
  .mq__g {
    display: flex;
    align-items: center;
    gap: 44px;
    padding-right: 44px;
  }
  .mq__g span {
    font: 600 30px/1 var(--display);
    letter-spacing: -0.03em;
    white-space: nowrap;
    color: #e9ded3;
  }
  .mq__g em {
    font: italic 400 36px/1 var(--serif);
    color: var(--ember-2);
    white-space: nowrap;
  }
  .mq__g i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    box-shadow: 0 0 14px 3px rgba(255, 90, 31, 0.7);
    flex: none;
  }
  @keyframes mq {
    to {
      transform: translateX(-50%);
    }
  }

  /* ---------- OFFRE ---------- */
  .offer__panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.02fr 1fr;
    min-height: 660px;
    border-radius: 40px;
    overflow: clip;
    isolation: isolate;
    background:
      radial-gradient(70% 80% at 80% 58%, rgba(255, 86, 24, 0.3), rgba(255, 86, 24, 0.05) 55%, transparent 72%),
      linear-gradient(150deg, #1b1411 0%, #110c0a 55%, #0d0908 100%);
    border: 1px solid rgba(255, 190, 150, 0.12);
    box-shadow: 0 60px 120px -60px rgba(0, 0, 0, 0.9);
  }
  .offer__num {
    position: absolute;
    right: -3%;
    top: 50%;
    transform: translateY(-52%);
    font: 800 clamp(300px, 40vw, 600px) / 0.8 var(--display);
    letter-spacing: -0.08em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 150, 90, 0.1);
    z-index: -1;
    pointer-events: none;
  }
  .offer__copy {
    padding: clamp(40px, 6vw, 88px);
    align-self: center;
    position: relative;
    z-index: 2;
  }
  .offer__title {
    font-size: clamp(44px, 5.6vw, 86px);
  }
  .nw {
    white-space: nowrap;
  }
  .conds {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .conds li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px 9px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 240, 228, 0.035);
    font-size: 13.5px;
    font-weight: 600;
    color: #e1d5c9;
  }
  .conds :global(.i) {
    color: var(--ember-2);
  }
  .conds .x :global(.i) {
    color: var(--dim);
  }
  .offer__visual {
    position: relative;
    perspective: 1500px;
    min-height: 520px;
  }
  .stack {
    position: absolute;
    left: 48%;
    top: 52%;
    width: min(31vw, 430px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
  }
  .dw,
  .disc {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .disc {
    transform: rotateX(62deg);
  }
  .disc img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    clip-path: circle(49.2%);
  }
  .disc__sh {
    position: absolute;
    inset: -4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.4) 60%, transparent);
    filter: blur(14px);
    transform: translateZ(-34px);
  }
  .disc__em {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 140, 60, 0.75), rgba(255, 80, 20, 0.3) 45%, transparent 75%);
    filter: blur(6px);
    transform: translateZ(-50px);
  }
  .disc__lt {
    position: absolute;
    inset: 0.8%;
    border-radius: 50%;
    transform: translateZ(1px);
    background:
      radial-gradient(circle at 30% 22%, rgba(255, 228, 196, 0.16), transparent 45%),
      radial-gradient(circle at 70% 84%, rgba(20, 6, 0, 0.4), transparent 55%);
  }
  .dtag {
    position: absolute;
    top: 50%;
    left: 88%;
    transform: translate3d(0, -50%, 40px);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px 8px 8px;
    border-radius: 999px;
    background: rgba(18, 12, 10, 0.6);
    border: 1px solid var(--line-2);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font: 700 13px/1 var(--sans);
    white-space: nowrap;
  }
  .dtag i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font: italic 400 16px/1 var(--serif);
    background: rgba(255, 240, 228, 0.08);
  }
  .dtag--hot {
    background: var(--grad-btn);
    color: #170903;
    border-color: transparent;
    box-shadow: 0 14px 40px -10px rgba(255, 90, 31, 0.8);
  }
  .dtag--hot i {
    background: rgba(23, 9, 3, 0.14);
  }
  .dtag--l {
    left: auto;
    right: 88%;
  }

  /* ---------- SIGNATURES ---------- */
  .sig {
    padding-top: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  /* ---------- CINÉMA ---------- */
  .cine {
    position: relative;
    height: min(94vh, 880px);
    min-height: 620px;
    overflow: clip;
    display: flex;
    align-items: flex-start;
    isolation: isolate;
  }
  .cine__media {
    position: absolute;
    inset: -10% 0;
    z-index: -2;
  }
  .cine__media :global(picture),
  .cine__media :global(.cine__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 58%;
  }
  .cine::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(10, 8, 7, 0.92) 0%, rgba(10, 8, 7, 0.7) 30%, rgba(10, 8, 7, 0.08) 62%, rgba(10, 8, 7, 0.25) 100%),
      linear-gradient(180deg, var(--bg) 0%, rgba(10, 8, 7, 0) 22%, rgba(10, 8, 7, 0) 70%, var(--bg) 100%);
  }
  .cine__copy {
    padding-top: clamp(90px, 10vw, 150px);
  }
  .cine .h2 {
    max-width: 640px;
  }
  .stats {
    display: flex;
    gap: 14px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .stat {
    padding: 18px 22px;
    border-radius: 20px;
    background: rgba(14, 10, 8, 0.5);
    border: 1px solid var(--line-2);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    min-width: 150px;
  }
  .stat b {
    display: block;
    font: 700 34px/1 var(--display);
    letter-spacing: -0.04em;
  }
  .stat em {
    font: italic 400 1.1em/1 var(--serif);
    letter-spacing: 0;
    color: var(--gold);
  }
  .stat span {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  /* ---------- MENUS ---------- */
  .menu-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 22px;
  }
  .combos {
    display: grid;
    gap: 22px;
  }
  .lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3vw, 44px);
    padding: clamp(28px, 3vw, 44px);
    border-radius: 28px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 240, 228, 0.03), rgba(255, 240, 228, 0.01));
  }
  .list__h {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
    font: italic 400 40px/1 var(--serif);
  }
  .list__h a:hover {
    color: var(--gold);
  }
  .list__h small {
    font: 700 10.5px/1 var(--sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
    font-style: normal;
  }

  /* ---------- LIVRAISON ---------- */
  .deliv {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: 22px;
  }
  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .panel__t {
    font: 700 28px/1 var(--display);
    letter-spacing: -0.035em;
    margin-bottom: 22px;
  }
  .panel__head .panel__t {
    margin: 0;
  }
  .panel__t em {
    font: italic 400 1.15em/1 var(--serif);
    color: var(--ember-2);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    border-radius: 999px;
    font: 700 12.5px/1 var(--sans);
    background: rgba(90, 200, 120, 0.08);
    color: #9ee3b0;
    border: 1px solid rgba(120, 220, 150, 0.2);
  }
  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6fe08f;
    box-shadow: 0 0 10px 2px rgba(111, 224, 143, 0.7);
  }
  .status:global(.closed) {
    background: rgba(255, 90, 31, 0.08);
    color: var(--gold);
    border-color: rgba(255, 140, 70, 0.25);
  }
  .status:global(.closed) i {
    background: var(--ember);
    box-shadow: 0 0 10px 2px rgba(255, 90, 31, 0.7);
  }
  .radius {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(24px, 3vw, 44px);
    align-items: center;
  }
  .radar {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }
  .radar svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .radar__sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg 290deg, rgba(255, 110, 40, 0.28) 360deg);
    -webkit-mask: radial-gradient(closest-side, #000 0 69.2%, transparent 69.6%);
    mask: radial-gradient(closest-side, #000 0 69.2%, transparent 69.6%);
    animation: spin 6s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .fact {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .fact:first-child {
    padding-top: 0;
  }
  .fact:last-child {
    border-bottom: 0;
  }
  .fact .ic {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: var(--ember-2);
    background: rgba(255, 90, 31, 0.08);
    border: 1px solid rgba(255, 130, 60, 0.18);
  }
  .fact b {
    display: block;
    font: 700 18px/1.15 var(--display);
    letter-spacing: -0.03em;
  }
  .fact span {
    display: block;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .zones {
    margin-top: 30px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .zones h4 {
    margin-bottom: 14px;
    font: 700 10.5px/1 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .zones ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .zones li {
    padding: 8px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 240, 228, 0.025);
    font-size: 13px;
    font-weight: 600;
    color: #d5c8bb;
  }
  .zones li.me {
    border-color: rgba(255, 140, 70, 0.45);
    color: var(--gold);
    background: rgba(255, 90, 31, 0.08);
  }
  .hours li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    margin: 0 -16px;
    border-radius: 14px;
    font-size: 14.5px;
    border-bottom: 1px solid var(--line);
  }
  .hours li:last-child {
    border-bottom: 0;
  }
  .hours li > span:first-child {
    font-weight: 600;
    color: #e3d7cb;
  }
  .sl {
    display: flex;
    justify-content: flex-end;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .sl i {
    font-style: normal;
    white-space: nowrap;
  }
  .sl i + i::before {
    content: '·';
    margin: 0 10px;
    color: var(--dim);
  }
  .hours li:global(.today) {
    background: linear-gradient(90deg, rgba(255, 90, 31, 0.14), rgba(255, 90, 31, 0.02));
    border-bottom-color: transparent;
    box-shadow: inset 2px 0 0 var(--ember);
  }
  .hours li:global(.today) > span:first-child::after {
    content: "Aujourd'hui";
    margin-left: 10px;
    font: 700 9.5px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ember-2);
  }
  .hours li:global(.today) .sl {
    color: var(--text);
  }
  .addr {
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .addr p {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--muted);
  }
  .addr b {
    display: block;
    color: var(--text);
    font-size: 15.5px;
  }

  /* ---------- FAQ ---------- */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: start;
  }
  .faq-grid > div:first-child {
    position: sticky;
    top: calc(var(--hdr) + 24px);
  }
  .faq-grid a strong {
    color: var(--gold);
  }

  /* ---------- APPEL FINAL ---------- */
  .final {
    position: relative;
    overflow: clip;
    text-align: center;
    padding: clamp(40px, 5vw, 80px) 0 0;
    min-height: clamp(820px, 72vw, 1040px);
    isolation: isolate;
  }
