---
import { SITE } from '../data/site';
const fmt = (t: string) => t.replace(':', 'h');
---

<div class="hours" data-hours data-schedule={JSON.stringify(SITE.hours.map((d) => d.slots))}>
  <div class="hours__status" data-hours-status>
    <span class="hours__dot"></span>
    <span data-hours-label>Horaires d'ouverture</span>
  </div>
  <table class="hours__table">
    <caption class="sr-only">Horaires d'ouverture de {SITE.name}</caption>
    <tbody>
      {
        SITE.hours.map((d, i) => (
          <tr data-day={i}>
            <th scope="row">{d.day}</th>
            <td>{d.slots.length ? d.slots.map(([a, b]) => `${fmt(a)} – ${fmt(b)}`).join(' / ') : 'Fermé'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .hours {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--cream);
    color: var(--text-on-light);
    box-shadow: var(--shadow-lg);
  }
  .hours__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: rgba(27, 19, 16, 0.06);
    font-weight: 800;
    font-size: 0.92rem;
  }
  .hours__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #9b8b80;
  }
  .hours.is-open .hours__dot {
    background: var(--basil);
    box-shadow: 0 0 0 0 rgba(47, 168, 102, 0.6);
    animation: live 1.8s infinite;
  }
  .hours.is-closed .hours__dot {
    background: var(--tomato);
  }
  @keyframes live {
    to {
      box-shadow: 0 0 0 12px rgba(47, 168, 102, 0);
    }
  }
  .hours__table {
    width: 100%;
    border-collapse: collapse;
  }
  .hours__table th,
  .hours__table td {
    padding: 13px 4px;
    border-bottom: 1px solid var(--line-light);
    text-align: left;
    font-size: 1rem;
  }
  .hours__table th {
    font-weight: 700;
  }
  .hours__table td {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--muted-on-light);
  }
  .hours__table tr:last-child th,
  .hours__table tr:last-child td {
    border-bottom: 0;
  }
  .hours__table tr.is-today th,
  .hours__table tr.is-today td {
    color: var(--tomato-2);
    font-weight: 800;
  }
</style>

<script>
  // Statut "ouvert / fermé" calculé à l'heure de Paris
  document.querySelectorAll<HTMLElement>('[data-hours]').forEach((el) => {
    const schedule = JSON.parse(el.dataset.schedule || '[]') as Array<Array<[string, string]>>;
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const wd = parts.find((p) => p.type === 'weekday')?.value ?? 'Mon';
    const h = Number(parts.find((p) => p.type === 'hour')?.value ?? 0);
    const m = Number(parts.find((p) => p.type === 'minute')?.value ?? 0);
    const idx = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(wd);
    const now = h * 60 + m;
    const toMin = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
    el.querySelector(`tr[data-day="${idx}"]`)?.classList.add('is-today');
    const today = schedule[idx] ?? [];
    const open = today.find(([a, b]) => now >= toMin(a) && now < toMin(b));
    const label = el.querySelector('[data-hours-label]')!;
    if (open) {
      el.classList.add('is-open');
      label.textContent = `Ouvert maintenant · jusqu'à ${open[1].replace(':', 'h')}`;
    } else {
      el.classList.add('is-closed');
      const next = today.find(([a]) => toMin(a) > now);
      label.textContent = next ? `Fermé · ouvre à ${next[0].replace(':', 'h')}` : 'Fermé pour aujourd’hui';
    }
  });
</script>
