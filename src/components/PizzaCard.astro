---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { SIZES, BASES, TAGS, minPrice, type Pizza, type SizeKey } from '../data/menu';
import { SITE, formatPrice } from '../data/site';
import { pizzaPhoto } from '../lib/photos';

interface Props {
  pizza: Pizza;
  headingLevel?: 'h2' | 'h3';
  label?: string;
  priority?: boolean;
}
const { pizza, headingLevel = 'h3', label, priority = false } = Astro.props;
const H = headingLevel;
const href = `/pizzas/${pizza.slug}/`;
const sizes = SIZES.filter((s) => pizza.prices[s.key] != null);
const def: SizeKey = pizza.prices.senior != null ? 'senior' : sizes[0].key;
const excluded = SITE.offer.conditions.toLowerCase().includes(pizza.name.toLowerCase());
const tag = label ?? (pizza.tags?.[0] ? TAGS[pizza.tags[0]].label : BASES[pizza.base]);
const fmt = (n: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: 2 });
---

<article
  class="card"
  data-tilt
  data-pcard
  data-filter-item
  data-base={pizza.base}
  data-tags={(pizza.tags ?? []).join(' ')}
  data-search={`${pizza.name} ${pizza.ingredients.join(' ')}`.toLowerCase()}
>
  <a href={href} class="card__media" tabindex="-1" aria-hidden="true">
    <Photo src={pizzaPhoto(pizza)} alt="" sizes="(min-width: 1200px) 320px, (min-width: 700px) 45vw, 80vw" widths={[320, 480, 640, 800]} class="card__img" priority={priority} />
    <span class="pill card__tag">{tag}</span>
    <span class="card__from">dès<b>{formatPrice(minPrice(pizza))}</b></span>
  </a>
  <div class="card__body">
    <H class="card__name"><a href={href}>{pizza.name}</a></H>
    <p class="card__ing">{pizza.ingredients.join(', ')}.</p>
    <div class="sizes" role="radiogroup" aria-label={`Taille de la pizza ${pizza.name}`}>
      {
        sizes.map((s) => (
          <button
            type="button"
            role="radio"
            aria-checked={s.key === def ? 'true' : 'false'}
            class:list={{ on: s.key === def }}
            data-size={s.key}
            data-label={s.label}
            data-price={pizza.prices[s.key]}
            data-offer={s.key !== 'junior' && !excluded ? '1' : '0'}
          >
            <span>{s.label}</span>
            <b>{fmt(pizza.prices[s.key]!)}</b>
          </button>
        ))
      }
    </div>
    <button
      type="button"
      class="add"
      data-add
      data-id={`${pizza.slug}:${def}`}
      data-name={`Pizza ${pizza.name}`}
      data-size-label={SIZES.find((s) => s.key === def)!.label}
      data-price={pizza.prices[def]}
      data-offer={def !== 'junior' && !excluded ? '1' : '0'}
      data-slug={pizza.slug}
    >
      <span>Ajouter</span>
      <span class="add__pr">{formatPrice(pizza.prices[def]!)}</span>
      <span class="add__plus"><Icon name="plus" size={18} stroke={2.4} /></span>
    </button>
  </div>
</article>

<style>
  .card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 28px;
    padding: 10px 10px 12px;
    background: var(--card);
    border: 1px solid var(--line);
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.6s var(--ease),
      border-color 0.4s,
      box-shadow 0.5s;
  }
  .card:hover {
    border-color: rgba(255, 130, 60, 0.32);
    box-shadow:
      0 40px 90px -40px rgba(255, 90, 31, 0.45),
      0 20px 50px -30px rgba(0, 0, 0, 0.9);
  }
  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    background: #1a1310;
  }
  .card__media :global(.card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
    transition: transform 1.2s var(--ease);
  }
  .card:hover .card__media :global(.card__img) {
    transform: scale(1.09);
  }
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 8, 7, 0.35) 0%, transparent 26%, transparent 58%, rgba(10, 8, 7, 0.75) 100%);
    pointer-events: none;
  }
  .card__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
  }
  .card__from {
    position: absolute;
    left: 16px;
    bottom: 14px;
    z-index: 2;
    font: 600 12.5px/1 var(--sans);
    color: #e6d8cb;
  }
  .card__from b {
    font: 700 22px/1 var(--display);
    letter-spacing: -0.02em;
    color: #fff;
    margin-left: 5px;
  }
  .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 18px 8px 0;
  }
  .card__name {
    font: 700 25px/1.05 var(--display);
    letter-spacing: -0.035em;
  }
  .card__name a:hover {
    color: var(--gold);
  }
  .card__ing {
    margin: 9px 0 18px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
    flex: 1;
  }
  .sizes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: 16px;
    background: rgba(255, 240, 228, 0.03);
    border: 1px solid var(--line);
  }
  .sizes button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 10px 2px 9px;
    border-radius: 12px;
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }
  .sizes span {
    font: 700 9.5px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .sizes b {
    font: 700 15px/1 var(--sans);
    font-variant-numeric: tabular-nums;
    color: #d7c9bc;
  }
  .sizes button:hover b {
    color: #fff;
  }
  .sizes button.on {
    background: linear-gradient(180deg, rgba(255, 130, 60, 0.2), rgba(255, 90, 31, 0.07));
    box-shadow: inset 0 0 0 1px rgba(255, 140, 70, 0.55);
  }
  .sizes button.on span {
    color: var(--gold);
  }
  .sizes button.on b {
    color: #fff;
  }
  .add {
    margin-top: 10px;
    width: 100%;
    height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    padding: 0 7px 0 18px;
    background: rgba(255, 240, 228, 0.045);
    border: 1px solid var(--line-2);
    font: 700 14px/1 var(--sans);
    transition:
      background 0.35s,
      color 0.35s,
      border-color 0.35s;
  }
  .add__pr {
    margin-left: auto;
    margin-right: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    font-weight: 600;
  }
  .add__plus {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--grad-btn);
    color: #170903;
    box-shadow: 0 8px 20px -8px rgba(255, 90, 31, 0.9);
    transition: transform 0.4s var(--spring);
  }
  .add:hover {
    background: var(--grad-btn);
    color: #170903;
    border-color: transparent;
  }
  .add:hover .add__pr {
    color: #3a1706;
  }
  .add:hover .add__plus {
    background: #170903;
    color: var(--ember-2);
    box-shadow: none;
  }
  .add:global(.is-added) .add__plus {
    transform: rotate(90deg) scale(1.1);
  }
</style>

<script>
  // Sélecteur de taille : met à jour le bouton « Ajouter »
  document.querySelectorAll<HTMLElement>('[data-pcard]').forEach((card) => {
    const add = card.querySelector<HTMLButtonElement>('.add')!;
    const pr = add.querySelector('.add__pr')!;
    const btns = [...card.querySelectorAll<HTMLButtonElement>('.sizes button')];
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => {
          x.classList.toggle('on', x === b);
          x.setAttribute('aria-checked', String(x === b));
        });
        const price = Number(b.dataset.price);
        add.dataset.id = `${add.dataset.slug}:${b.dataset.size}`;
        add.dataset.sizeLabel = b.dataset.label;
        add.dataset.price = String(price);
        add.dataset.offer = b.dataset.offer;
        pr.textContent = price.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' €';
      }),
    );
  });
</script>
