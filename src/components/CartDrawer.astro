---
import Icon from './Icon.astro';
import { SITE, telHref } from '../data/site';
---

<div class="cart" data-cart hidden>
  <div class="cart__overlay" data-cart-close></div>
  <aside class="cart__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title" tabindex="-1">
    <header class="cart__head">
      <h2 id="cart-title">Votre <em>commande</em></h2>
      <button type="button" class="cart__close" data-cart-close aria-label="Fermer le panier"><Icon name="x" /></button>
    </header>

    <div class="cart__offer">
      <span class="cart__offer-ic"><Icon name="gift" size={18} /></span>
      <p><strong>{SITE.offer.title}</strong><span>{SITE.offer.conditions}</span></p>
    </div>

    <div class="cart__body" data-lenis-prevent>
      <ul class="cart__list" data-cart-list></ul>
      <div class="cart__empty" data-cart-empty>
        <p class="cart__empty-t">Votre panier est vide</p>
        <p>Ajoutez vos pizzas préférées depuis la carte.</p>
        <a href="/carte/" class="btn btn-glass btn-sm">Voir la carte <Icon name="arrow" size={18} /></a>
      </div>
    </div>

    <footer class="cart__foot" data-cart-foot>
      <fieldset class="cart__mode">
        <legend class="sr-only">Mode de retrait</legend>
        <label><input type="radio" name="cart-mode" value="livraison" checked /><span><Icon name="scooter" size={18} /> Livraison</span></label>
        <label><input type="radio" name="cart-mode" value="emporter" /><span><Icon name="store" size={18} /> À emporter</span></label>
      </fieldset>
      <dl class="cart__totals">
        <div><dt>Sous-total</dt><dd data-cart-subtotal>0,00 €</dd></div>
        <div class="cart__discount" data-cart-discount-row hidden><dt>3<sup>e</sup> pizza offerte</dt><dd data-cart-discount>0,00 €</dd></div>
        <div class="cart__total"><dt>Total</dt><dd data-cart-total>0,00 €</dd></div>
      </dl>
      <p class="cart__min" data-cart-min hidden>Minimum de commande en livraison : {SITE.delivery.minOrder} €</p>
      <a href={telHref} class="btn btn-ember cart__call"><Icon name="phone" stroke={2} /> Commander au {SITE.phone}</a>
      <button type="button" class="btn btn-glass btn-sm cart__copy" data-cart-copy><Icon name="copy" size={18} /> Copier le récapitulatif</button>
      <p class="cart__note">Total indicatif — la commande est confirmée par téléphone.</p>
    </footer>
  </aside>
</div>

<button type="button" class="cart-fab" data-cart-open data-cart-fab aria-label="Voir mon panier">
  <span class="cart-fab__ic"><Icon name="bag" /><span class="cart-fab__n" data-cart-count>0</span></span>
  <span>Mon panier</span>
  <span class="cart-fab__total" data-cart-fab-total>0,00 €</span>
</button>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<style>
  .cart {
    position: fixed;
    inset: 0;
    z-index: 120;
  }
  .cart__overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 3, 2, 0.7);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .cart:global(.is-open) .cart__overlay {
    opacity: 1;
  }
  .cart__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(460px, 100%);
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #17110e, #0d0a08);
    border-left: 1px solid var(--line-2);
    box-shadow: -40px 0 100px rgba(0, 0, 0, 0.6);
    transform: translateX(100%);
    transition: transform 0.55s var(--ease);
  }
  .cart:global(.is-open) .cart__panel {
    transform: none;
  }
  .cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px;
    border-bottom: 1px solid var(--line);
  }
  .cart__head h2 {
    font: 700 26px/1 var(--display);
    letter-spacing: -0.035em;
  }
  .cart__head em {
    font: italic 400 1.15em/1 var(--serif);
    color: var(--ember-2);
  }
  .cart__close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
  }
  .cart__close:hover {
    border-color: rgba(255, 150, 90, 0.5);
  }
  .cart__offer {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 16px 24px 0;
    padding: 14px 16px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255, 120, 50, 0.16), rgba(255, 90, 31, 0.04));
    border: 1px solid rgba(255, 130, 60, 0.28);
    font-size: 13px;
    line-height: 1.4;
  }
  .cart__offer-ic {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--grad-btn);
    color: #170903;
  }
  .cart__offer strong {
    display: block;
    font-size: 14px;
  }
  .cart__offer span {
    color: var(--muted);
  }
  .cart__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 24px;
  }
  .cart__list :global(li) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .cart__list :global(.ci-name) {
    font: 700 16px/1.2 var(--display);
    letter-spacing: -0.02em;
  }
  .cart__list :global(.ci-size) {
    display: block;
    margin-top: 4px;
    font: 600 12px/1.3 var(--sans);
    color: var(--muted);
    letter-spacing: 0;
  }
  .cart__list :global(.ci-price) {
    font: 700 16px/1.2 var(--display);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .cart__list :global(.ci-free) {
    display: block;
    margin-top: 4px;
    font: 800 10px/1 var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--basil);
  }
  .cart__list :global(.ci-qty) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    width: max-content;
  }
  .cart__list :global(.ci-qty button) {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255, 240, 228, 0.06);
    font-weight: 700;
  }
  .cart__list :global(.ci-qty button:hover) {
    background: var(--grad-btn);
    color: #170903;
  }
  .cart__list :global(.ci-qty span) {
    min-width: 24px;
    text-align: center;
    font-weight: 800;
  }
  .cart__list :global(.ci-remove) {
    justify-self: end;
    align-self: center;
    font-size: 12.5px;
    color: var(--dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cart__empty {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 56px 0;
    text-align: center;
    color: var(--muted);
  }
  .cart__empty-t {
    font: 700 22px/1.1 var(--display);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .cart__empty .btn {
    margin-top: 10px;
  }
  .cart__foot {
    display: grid;
    gap: 12px;
    padding: 18px 24px calc(18px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: rgba(8, 6, 5, 0.6);
  }
  .cart__mode {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .cart__mode label {
    position: relative;
    cursor: pointer;
  }
  .cart__mode input {
    position: absolute;
    opacity: 0;
  }
  .cart__mode span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 13.5px;
    color: var(--muted);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .cart__mode input:checked + span {
    background: rgba(255, 240, 228, 0.09);
    color: var(--text);
    box-shadow: inset 0 0 0 1px rgba(255, 140, 70, 0.45);
  }
  .cart__totals {
    display: grid;
    gap: 6px;
    margin: 4px 0 0;
    font-size: 14.5px;
  }
  .cart__totals div {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
  }
  .cart__totals dd {
    margin: 0;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .cart__discount dd {
    color: var(--basil);
  }
  .cart__total {
    padding-top: 8px;
    font: 700 22px/1.2 var(--display);
    letter-spacing: -0.03em;
  }
  .cart__total dt {
    color: var(--text);
  }
  .cart__min {
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
  }
  .cart__call,
  .cart__copy {
    width: 100%;
  }
  .cart__note {
    font-size: 12px;
    color: var(--dim);
    text-align: center;
  }

  .cart-fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 7px 20px 7px 7px;
    border-radius: 999px;
    background: var(--grad-btn);
    color: #170903;
    font-weight: 700;
    font-size: 14px;
    box-shadow:
      0 18px 50px -12px rgba(255, 90, 31, 0.8),
      inset 0 1px 0 rgba(255, 236, 210, 0.55);
    transform: translateY(calc(100% + 40px));
    transition: transform 0.6s var(--spring);
  }
  .cart-fab:global(.is-visible) {
    transform: none;
  }
  .cart-fab__ic {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(23, 9, 3, 0.14);
  }
  .cart-fab__n {
    position: absolute;
    top: -4px;
    right: -6px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: #170903;
    color: var(--gold);
    font: 800 11px/20px var(--sans);
    text-align: center;
  }
  .cart-fab__total {
    font: 700 15px/1 var(--display);
    padding-left: 12px;
    border-left: 1px solid rgba(23, 9, 3, 0.25);
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 92px;
    z-index: 130;
    max-width: calc(100vw - 32px);
    padding: 13px 20px;
    border-radius: 16px;
    background: rgba(22, 16, 13, 0.9);
    border: 1px solid var(--line-2);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.9);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transform: translate(-50%, 40px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.5s var(--ease),
      opacity 0.3s,
      visibility 0s 0.5s;
  }
  .toast:global(.is-visible) {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.5s var(--ease),
      opacity 0.3s;
  }
</style>

<script>
  import { initCart } from '../scripts/cart';
  initCart();
</script>
