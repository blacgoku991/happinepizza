---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE, telHref } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="hdr" data-header>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${SITE.name} — accueil`}><Logo /></a>

    <nav class="nav" aria-label="Navigation principale">
      {
        NAV.map((n) => (
          <a href={n.href} class:list={{ on: isActive(n.href) }} aria-current={isActive(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__act">
      <a class="tel" href={telHref} aria-label={`Appeler le ${SITE.phone}`}>
        <span class="tel__ic"><Icon name="phone" size={17} stroke={2} /></span>
        <span class="tel__txt"><small>Commander</small><span>{SITE.phone}</span></span>
      </a>
      <button class="icon-btn" type="button" data-cart-open aria-label="Ouvrir le panier">
        <Icon name="bag" />
        <span class="badge" data-cart-count>0</span>
      </button>
      <button class="icon-btn burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mnav" aria-label="Ouvrir le menu">
        <Icon name="menu" class="burger__open" />
        <Icon name="x" class="burger__close" />
      </button>
    </div>
  </div>
</header>

<nav class="mnav" id="mnav" data-mnav aria-label="Menu mobile" data-lenis-prevent>
  <div class="wrap mnav__in">
    <a href="/">Accueil</a>
    {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
    <a class="btn btn-ember" href={telHref}><Icon name="phone" stroke={2} /> {SITE.phone}</a>
    <p class="mnav__addr">{SITE.address.street}, {SITE.address.city}</p>
  </div>
</nav>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    border-bottom: 1px solid transparent;
    transition:
      background 0.5s,
      border-color 0.5s,
      transform 0.5s var(--ease);
  }
  .hdr.scrolled {
    background: rgba(10, 8, 7, 0.7);
    border-color: var(--line);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
  }
  .hdr.hidden:not(.open) {
    transform: translateY(-100%);
  }
  .hdr.open {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
  }
  .hdr__in {
    height: var(--hdr);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .hdr__logo {
    justify-self: start;
  }
  .nav {
    display: flex;
    gap: 2px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(255, 240, 228, 0.035);
    border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }
  .nav a {
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: #cdbfb2;
    transition:
      color 0.3s,
      background 0.3s;
  }
  .nav a:hover {
    color: #fff;
    background: rgba(255, 240, 228, 0.07);
  }
  .nav a.on {
    color: var(--text);
    background: rgba(255, 240, 228, 0.09);
  }
  .hdr__act {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-self: end;
  }
  .tel {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    height: 48px;
    padding: 0 20px 0 6px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-weight: 700;
    font-size: 14.5px;
    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .tel:hover {
    border-color: rgba(255, 150, 90, 0.5);
    background: rgba(255, 240, 228, 0.04);
  }
  .tel__ic {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--grad-btn);
    display: grid;
    place-items: center;
    color: #170903;
    box-shadow: 0 6px 20px -6px rgba(255, 90, 31, 0.8);
  }
  .tel__txt {
    line-height: 1;
  }
  .tel__txt small {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 3px;
  }
  .icon-btn {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    display: grid;
    place-items: center;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .icon-btn:hover {
    border-color: rgba(255, 150, 90, 0.5);
    background: rgba(255, 240, 228, 0.04);
  }
  .badge {
    position: absolute;
    top: -2px;
    right: -3px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 10px;
    background: var(--ember);
    color: #170903;
    font: 800 11px/20px var(--sans);
    text-align: center;
    box-shadow:
      0 0 0 3px var(--bg),
      0 0 16px rgba(255, 90, 31, 0.8);
    transform: scale(0);
    transition: transform 0.4s var(--spring);
  }
  .badge:global(.has-items) {
    transform: scale(1);
  }
  .icon-btn:global(.bump) .badge {
    transform: scale(1.35);
  }
  .burger {
    display: none;
  }
  .burger :global(.burger__close) {
    display: none;
  }
  .hdr.open .burger :global(.burger__close) {
    display: block;
  }
  .hdr.open .burger :global(.burger__open) {
    display: none;
  }

  .mnav {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(10, 8, 7, 0.97);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s,
      visibility 0.4s;
  }
  .mnav.open {
    opacity: 1;
    visibility: visible;
  }
  .mnav__in {
    display: flex;
    flex-direction: column;
    padding-block: calc(var(--hdr) + 20px) 40px;
  }
  .mnav a:not(.btn) {
    font: 700 clamp(32px, 9vw, 44px) / 1.2 var(--display);
    letter-spacing: -0.04em;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .mnav .btn {
    margin-top: 28px;
    align-self: flex-start;
  }
  .mnav__addr {
    margin-top: 18px;
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 1180px) {
    .nav a {
      padding: 10px 11px;
    }
    .tel__txt small {
      display: none;
    }
  }
  @media (max-width: 1060px) {
    :global(:root) {
      --hdr: 68px;
    }
    .nav {
      display: none;
    }
    .hdr__in {
      grid-template-columns: 1fr auto;
    }
    .burger {
      display: grid;
    }
    .tel {
      padding: 0;
      width: 48px;
      justify-content: center;
    }
    .tel__txt {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .hdr__act {
      gap: 8px;
    }
    .icon-btn,
    .tel {
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = hdr.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mnav = document.querySelector<HTMLElement>('[data-mnav]')!;
  let lastY = scrollY;
  const onScroll = () => {
    const y = scrollY;
    hdr.classList.toggle('scrolled', y > 24);
    if (y > 500 && y > lastY + 4) hdr.classList.add('hidden');
    else if (y < lastY - 4 || y < 500) hdr.classList.remove('hidden');
    lastY = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const setOpen = (o: boolean) => {
    hdr.classList.toggle('open', o);
    mnav.classList.toggle('open', o);
    btn.setAttribute('aria-expanded', String(o));
    btn.setAttribute('aria-label', o ? 'Fermer le menu' : 'Ouvrir le menu');
    document.documentElement.style.overflow = o ? 'hidden' : '';
    dispatchEvent(new CustomEvent(o ? 'hp:lock' : 'hp:unlock'));
  };
  btn.addEventListener('click', () => setOpen(!mnav.classList.contains('open')));
  mnav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && mnav.classList.contains('open') && setOpen(false));
</script>
