---
import Icon from './Icon.astro';
interface Props {
  items: Array<{ q: string; a: string }>;
  dark?: boolean;
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((f, i) => (
      <details class="faq__item" open={i === 0}>
        <summary>
          <h3 class="faq__q">{f.q}</h3>
          <span class="faq__icon">
            <Icon name="plus" size={20} />
          </span>
        </summary>
        <div class="faq__a">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 10px;
  }
  .faq__item {
    border-radius: 22px;
    background: linear-gradient(180deg, #16110e, #110d0b);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .faq__item[open] {
    border-color: rgba(255, 140, 70, 0.3);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font: 600 17px/1.3 var(--display);
    letter-spacing: -0.02em;
  }
  .faq__icon {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    color: var(--ember-2);
    transition: transform 0.5s var(--spring), background 0.3s, color 0.3s;
  }
  details[open] .faq__icon {
    transform: rotate(135deg);
    background: var(--grad-btn);
    color: #170903;
    border-color: transparent;
  }
  .faq__a {
    padding: 0 22px 22px;
    color: var(--muted);
    font-size: 15px;
  }
</style>
