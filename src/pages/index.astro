---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hours from '../components/Hours.astro';
import Faq from '../components/Faq.astro';
import { SITE, telHref } from '../data/site';
import { PIZZAS, FEATURED, CATEGORIES, PIZZA_CATEGORY, BASES, minPrice } from '../data/menu';
import { pizzaArt } from '../lib/pizzaArt';
import { foodArt } from '../lib/foodArt';
import { formatPrice } from '../data/site';
import { faqSchema } from '../lib/schema';
import { FAQS } from '../data/faq';

const title = `Pizzeria à ${SITE.address.city} – Livraison | ${SITE.name}`;
const description = `Pizzeria artisanale à ${SITE.address.city} : pizzas à pâte fraîche, pâtes, salades, desserts. Livraison gratuite ${SITE.delivery.radiusKm} km, à emporter, sur place. ☎ ${SITE.phone}`;

const heroPizza = pizzaArt({ slug: 'hero-fallback', base: 'tomate', ingredients: ['Olives', 'Champignons', 'Tomates cerises', 'Poivrons', 'Merguez'] });

const categoryTiles = [
  { slug: PIZZA_CATEGORY.slug, name: PIZZA_CATEGORY.name, count: PIZZAS.length, from: Math.min(...PIZZAS.map(minPrice)), art: pizzaArt(PIZZAS[0]) },
  ...CATEGORIES.map((c) => ({
    slug: c.slug,
    name: c.name,
    count: c.items.length,
    from: Math.min(...c.items.map((i) => i.price)),
    art: foodArt(c.items[0].art, c.items[0].tint),
  })),
];

// points décoratifs sur le radar (angle doré pour une répartition harmonieuse)
const radarDots = Array.from({ length: 11 }, (_, i) => {
  const a = i * 2.39996 + 0.6;
  const d = 0.26 + ((i * 0.37) % 0.6);
  return [(50 + Math.cos(a) * d * 46).toFixed(1), (50 + Math.sin(a) * d * 46).toFixed(1)];
});

const marquee = ['Pâte fraîche du jour', 'Mozzarella fondante', `Livraison gratuite ${SITE.delivery.radiusKm} km`, SITE.offer.short, 'Ouvert 7j/7', 'Sur place · À emporter'];
---

<Base title={title} description={description} rawTitle jsonLd={[faqSchema(FAQS)]} bodyClass="page-home">
  <!-- ============ HERO 3D ============ -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__glow hero__glow--1"></div>
      <div class="hero__glow hero__glow--2"></div>
      <span class="hero__word" data-hero-word>PIZZA</span>
    </div>

    <div class="hero__stage" aria-hidden="true">
      <canvas class="hero__canvas" data-hero-canvas></canvas>
      <div class="hero__fallback" data-hero-fallback set:html={heroPizza} />
    </div>

    <div class="container hero__content" data-hero-content>
      <h1 id="hero-title" class="hero__title">
        <span class="eyebrow hero__eyebrow" data-reveal>Pizzeria artisanale · {SITE.address.city}</span>
        <span class="hero__headline" data-split data-split-now data-delay="0.2">
          La pizza qui rend <span class="serif text-saffron">heureux.</span>
        </span>
      </h1>
      <p class="lead hero__lead" data-reveal data-delay="0.35">
        Pâte fraîche pétrie chaque jour, garnitures généreuses et mozzarella qui file. En livraison, à emporter ou sur place à {SITE.address.city}.
      </p>
      <div class="hero__ctas" data-reveal data-delay="0.45">
        <a href="/carte/" class="btn btn--lg" data-magnetic>Découvrir la carte <Icon name="arrow" /></a>
        <a href={telHref} class="btn btn--lg btn--ghost"><Icon name="phone" /> {SITE.phone}</a>
      </div>
      <ul class="hero__chips" data-reveal data-delay="0.55">
        <li class="chip"><Icon name="bike" /> Livraison gratuite · {SITE.delivery.radiusKm} km</li>
        <li class="chip"><Icon name="clock" /> Ouvert 7j/7</li>
        <li class="chip"><Icon name="store" /> Sur place & à emporter</li>
      </ul>
    </div>

    <a href="/carte/pizzas/" class="hero__sticker" aria-label={`${SITE.offer.title} — voir les pizzas`} data-reveal data-delay="0.7">
      <svg viewBox="0 0 200 200" class="hero__sticker-ring" aria-hidden="true">
        <defs><path id="sticker-circle" d="M100 100m-76 0a76 76 0 1 1 152 0a76 76 0 1 1-152 0"></path></defs>
        <text><textPath href="#sticker-circle">★ 2 pizzas achetées ★ la 3e offerte ★ Senior & Méga </textPath></text>
      </svg>
      <span class="hero__sticker-core">3<sup>e</sup><small>offerte</small></span>
    </a>

    <div class="hero__scroll" aria-hidden="true">
      <span>Scrollez</span>
      <span class="hero__scroll-line"></span>
    </div>
  </section>

  <!-- ============ BANDEAU ============ -->
  <div class="band-wrap" aria-hidden="true"><div class="band">
    <div class="marquee" style="--duration: 28s">
      {
        [0, 1].map(() => (
          <div class="marquee__track">
            {marquee.map((m) => (
              <>
                <span>{m}</span>
                <Icon name="sparkles" size={28} />
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div></div>

  <!-- ============ SAVOIR-FAIRE ============ -->
  <section class="section on-light craft" aria-labelledby="craft-title">
    <div class="container">
      <div class="craft__grid">
        <div class="section-head">
          <span class="eyebrow">Notre savoir-faire</span>
          <h2 id="craft-title" class="h-1" data-split>Comme à la maison, <span class="serif text-tomato">en mieux.</span></h2>
          <p class="lead muted" data-reveal>
            Chez {SITE.name}, chaque pizza est préparée à la commande avec des ingrédients frais et soigneusement sélectionnés. Classiques
            indémodables ou recettes plus audacieuses : chaque bouchée est une explosion de saveurs.
          </p>
        </div>
        <ul class="craft__stats" data-reveal>
          <li><strong><span data-count={PIZZAS.length}>{PIZZAS.length}</span></strong><span>recettes de pizzas</span></li>
          <li><strong>3</strong><span>tailles : Junior, Senior, Méga</span></li>
          <li><strong>7<small>/7</small></strong><span>midi & soir</span></li>
          <li><strong><span data-count={SITE.delivery.radiusKm}>{SITE.delivery.radiusKm}</span><small>km</small></strong><span>de livraison gratuite</span></li>
        </ul>
      </div>

      <ul class="craft__cards">
        <li class="craft__card tilt" data-reveal>
          <span class="tilt__glare"></span>
          <span class="craft__icon tilt__pop"><Icon name="wheat" size={30} /></span>
          <h3 class="h-3">Pâte fraîche du jour</h3>
          <p class="muted">Pétrie chaque jour sur place pour une pâte moelleuse à cœur et croustillante dessous.</p>
        </li>
        <li class="craft__card tilt" data-reveal data-delay="0.08">
          <span class="tilt__glare"></span>
          <span class="craft__icon craft__icon--basil tilt__pop"><Icon name="leaf" size={30} /></span>
          <h3 class="h-3">Ingrédients choisis</h3>
          <p class="muted">Mozzarella fondante, légumes frais, viandes et fromages sélectionnés avec soin.</p>
        </li>
        <li class="craft__card tilt" data-reveal data-delay="0.16">
          <span class="tilt__glare"></span>
          <span class="craft__icon craft__icon--saffron tilt__pop"><Icon name="oven" size={30} /></span>
          <h3 class="h-3">Cuite à la minute</h3>
          <p class="muted">Garnie et enfournée à la commande, puis livrée chaude jusqu'à votre porte.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ SIGNATURES (scroll horizontal) ============ -->
  <section class="sig" data-hscroll aria-labelledby="sig-title">
    <div class="sig__inner">
      <div class="container sig__head">
        <div>
          <span class="eyebrow">Les incontournables</span>
          <h2 id="sig-title" class="h-1" data-split>Nos pizzas <span class="serif text-tomato">signature</span></h2>
        </div>
        <a href="/carte/pizzas/" class="btn btn--ghost">Toutes les pizzas <Icon name="arrow" /></a>
      </div>
      <div class="sig__viewport">
        <ol class="sig__track" data-hscroll-track>
          {
            FEATURED.map((p, i) => (
              <li class="sig__card">
                <a href={`/pizzas/${p.slug}/`} class="sig__link">
                  <span class="sig__num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="sig__art" data-spin set:html={pizzaArt(p)} />
                  <div class="sig__meta">
                    <span class="sig__base">{BASES[p.base]}</span>
                    <h3 class="sig__name">{p.name}</h3>
                    <p class="sig__ing">{p.ingredients.join(' · ')}</p>
                    <span class="sig__price">
                      dès <strong>{formatPrice(minPrice(p))}</strong>
                      <span class="sig__go"><Icon name="arrow-up-right" size={20} /></span>
                    </span>
                  </div>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ OFFRE ============ -->
  <section class="section offer" aria-labelledby="offer-title">
    <div class="container">
      <div class="offer__card">
        <div class="offer__stack" aria-hidden="true">
          <div class="offer__pz offer__pz--1" data-rotate="120" set:html={pizzaArt(PIZZAS.find((p) => p.slug === 'barbecue')!)} />
          <div class="offer__pz offer__pz--2" data-rotate="-140" set:html={pizzaArt(PIZZAS.find((p) => p.slug === 'chevre-miel')!)} />
          <div class="offer__pz offer__pz--3" data-rotate="160" set:html={pizzaArt(PIZZAS.find((p) => p.slug === 'reine')!)} />
          <span class="offer__free">Offerte !</span>
        </div>
        <div class="offer__text">
          <span class="eyebrow">Offre permanente</span>
          <h2 id="offer-title" class="h-1" data-split>
            2 pizzas achetées, <span class="serif text-saffron">la 3e offerte.</span>
          </h2>
          <p class="lead muted" data-reveal>{SITE.offer.conditions} Parfait pour les soirées entre amis ou en famille.</p>
          <div class="offer__ctas" data-reveal>
            <a href="/carte/pizzas/" class="btn btn--lg btn--saffron" data-magnetic>J'en profite <Icon name="arrow" /></a>
            <a href="/carte/menus/" class="btn btn--lg btn--ghost">Voir les menus</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LA CARTE ============ -->
  <section class="section on-light cats" aria-labelledby="cats-title">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">La carte</span>
        <h2 id="cats-title" class="h-1" data-split>Il y en a pour <span class="serif">toutes les faims.</span></h2>
        <p class="lead muted" data-reveal>Pizzas, menus, pâtes, salades, paninis, desserts et boissons fraîches.</p>
      </div>
      <ul class="cats__grid">
        {
          categoryTiles.map((c, i) => (
            <li data-reveal data-delay={(i % 4) * 0.06}>
              <a href={`/carte/${c.slug}/`} class:list={['cat tilt', { 'cat--big': i === 0 }]} data-tilt-max="8">
                <span class="tilt__glare" />
                <span class="cat__art tilt__pop" set:html={c.art} />
                <span class="cat__info">
                  <span class="cat__name">{c.name}</span>
                  <span class="cat__meta">
                    {c.count} choix · dès {formatPrice(c.from)}
                  </span>
                </span>
                <span class="cat__arrow">
                  <Icon name="arrow-up-right" size={22} />
                </span>
              </a>
            </li>
          ))
        }
        <li class="cats__cta" data-reveal data-delay="0.12">
          <a href="/carte/" class="cat cat--cta">
            <span class="cat__cta-title">Toute la carte <span class="serif">d'un coup d'œil</span></span>
            <span class="cat__meta">Pizzas, menus, pâtes, salades, paninis, desserts & boissons</span>
            <span class="cat__arrow"><Icon name="arrow-up-right" size={22} /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ COMMENT COMMANDER ============ -->
  <section class="section steps" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Commander en 3 étapes</span>
        <h2 id="steps-title" class="h-1" data-split>Simple, rapide, <span class="serif text-saffron">délicieux.</span></h2>
      </div>
      <ol class="steps__list">
        <li class="step" data-reveal>
          <span class="step__num">01</span>
          <span class="step__icon"><Icon name="search" size={28} /></span>
          <h3 class="h-3">Choisissez</h3>
          <p class="muted">Parcourez la carte et composez votre panier : pizzas, menus, desserts…</p>
        </li>
        <li class="step" data-reveal data-delay="0.1">
          <span class="step__num">02</span>
          <span class="step__icon"><Icon name="phone" size={28} /></span>
          <h3 class="h-3">Appelez-nous</h3>
          <p class="muted">Passez commande au <a href={telHref} class="text-saffron">{SITE.phone}</a>, en livraison ou à emporter.</p>
        </li>
        <li class="step" data-reveal data-delay="0.2">
          <span class="step__num">03</span>
          <span class="step__icon"><Icon name="heart" size={28} /></span>
          <h3 class="h-3">Régalez-vous</h3>
          <p class="muted">Votre commande est préparée à la minute et livrée bien chaude chez vous.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ LIVRAISON ============ -->
  <section class="section on-light zone" aria-labelledby="zone-title">
    <div class="container zone__grid">
      <div class="zone__text">
        <span class="eyebrow">Zone de livraison</span>
        <h2 id="zone-title" class="h-1" data-split>On livre <span class="serif">autour de chez vous.</span></h2>
        <p class="lead muted" data-reveal>
          Livraison gratuite dans un rayon de {SITE.delivery.radiusKm} km autour de {SITE.address.city}, dès {SITE.delivery.minOrder} € de commande.
        </p>
        <ul class="zone__towns" data-reveal>
          {SITE.zones.map((z) => <li class="chip"><Icon name="pin" size={16} /> {z}</li>)}
        </ul>
        <a href="/livraison/" class="btn" data-reveal>Tout savoir sur la livraison <Icon name="arrow" /></a>
      </div>
      <div class="zone__radar" aria-hidden="true">
        <div class="radar">
          <span class="radar__ring" style="--s: 1"></span>
          <span class="radar__ring" style="--s: 0.72"></span>
          <span class="radar__ring" style="--s: 0.44"></span>
          <span class="radar__sweep"></span>
          {radarDots.map(([x, y]) => <span class="radar__dot" style={`left:${x}%; top:${y}%`} />)}
          <span class="radar__center">
            <svg viewBox="0 0 64 64"><path d="M9.5 19.5c14.8-5.6 30.2-5.6 45 0L35.2 56.6c-1.4 2.6-5 2.6-6.4 0L9.5 19.5Z" fill="#ffb42e" /><path d="M6.5 17.8c16.4-7.1 34.6-7.1 51 0" fill="none" stroke="#ff4d1f" stroke-width="7.5" stroke-linecap="round" /><circle cx="24.2" cy="27.6" r="3.9" fill="#ff4d1f" /><circle cx="39.8" cy="27.6" r="3.9" fill="#ff4d1f" /><path d="M24.5 36.2c4.6 4.6 10.4 4.6 15 0" fill="none" stroke="#120c0a" stroke-width="3.4" stroke-linecap="round" /></svg>
          </span>
          <span class="radar__label">{SITE.delivery.radiusKm} km</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HORAIRES ============ -->
  <section class="section hours-sec" aria-labelledby="hours-title">
    <div class="container hours-sec__grid">
      <div>
        <span class="eyebrow">Horaires & adresse</span>
        <h2 id="hours-title" class="h-1" data-split>Midi & soir, <span class="serif text-saffron">7 jours sur 7.</span></h2>
        <address class="hours-sec__addr" data-reveal>
          <Icon name="pin" />
          <span>{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}</span>
        </address>
        <div class="hours-sec__ctas" data-reveal>
          <a href="/contact/" class="btn btn--ghost">Itinéraire & contact <Icon name="arrow" /></a>
        </div>
      </div>
      <div data-reveal><Hours /></div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section on-light" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="section-head">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 id="faq-title" class="h-1" data-split>Vous vous <span class="serif">demandez…</span></h2>
        <p class="lead muted" data-reveal>Une autre question ? Appelez-nous au <a href={telHref}><strong>{SITE.phone}</strong></a>.</p>
      </div>
      <Faq items={FAQS} />
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: max(100svh, 680px);
    display: grid;
    align-items: center;
    padding-top: var(--header-h);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }
  .hero__glow--1 {
    width: 60vw;
    height: 60vw;
    right: -12vw;
    top: 5%;
    background: radial-gradient(circle, rgba(255, 77, 31, 0.5), transparent 65%);
  }
  .hero__glow--2 {
    width: 40vw;
    height: 40vw;
    left: -10vw;
    bottom: -20%;
    background: radial-gradient(circle, rgba(255, 180, 46, 0.22), transparent 65%);
  }
  .hero__word {
    position: absolute;
    left: 50%;
    bottom: -0.16em;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(9rem, 30vw, 30rem);
    letter-spacing: -0.07em;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 246, 234, 0.09);
    white-space: nowrap;
    user-select: none;
  }
  .hero__stage {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    right: -7vw;
    width: min(60vw, 960px);
    display: grid;
    place-items: center;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  :global(.has-webgl) .hero__canvas {
    opacity: 1;
  }
  .hero__fallback {
    width: min(78%, 560px);
    filter: drop-shadow(0 40px 50px rgba(0, 0, 0, 0.55));
    animation: spin 60s linear infinite;
    transition: opacity 0.6s;
  }
  :global(.has-webgl) .hero__fallback {
    opacity: 0;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero__content {
    position: relative;
    display: grid;
    gap: 28px;
    padding-block: 60px 120px;
  }
  .hero__title {
    display: grid;
    gap: 22px;
    max-width: 11ch;
    font-size: clamp(3.4rem, 9vw, 8.6rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  .hero__eyebrow {
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    line-height: 1.3;
  }
  .hero__headline .serif {
    font-size: 1.08em;
    letter-spacing: -0.03em;
  }
  .hero__lead {
    max-width: 44ch;
    color: var(--muted-on-dark);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .hero__sticker {
    position: absolute;
    right: clamp(16px, 6vw, 90px);
    bottom: clamp(90px, 14vh, 150px);
    width: 150px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--saffron);
    color: var(--ink);
    box-shadow: 0 24px 50px -16px rgba(255, 180, 46, 0.55);
    transition: transform 0.6s var(--ease-spring);
  }
  .hero__sticker:hover {
    transform: scale(1.08) rotate(-8deg);
  }
  .hero__sticker-ring {
    position: absolute;
    inset: 0;
    animation: spin 18s linear infinite;
  }
  .hero__sticker-ring text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ink);
  }
  .hero__sticker-core {
    display: grid;
    justify-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }
  .hero__sticker-core sup {
    font-size: 0.45em;
    position: absolute;
    margin-left: 1.3em;
    margin-top: 0.1em;
  }
  .hero__sticker-core small {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 6px;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }
  .hero__scroll-line {
    width: 1.5px;
    height: 44px;
    background: linear-gradient(var(--cream), transparent);
    transform-origin: top;
    animation: scrollLine 2.2s var(--ease-out) infinite;
  }
  @keyframes scrollLine {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  @media (max-width: 900px) {
    .hero {
      align-items: start;
    }
    .hero__stage {
      top: auto;
      right: 50%;
      transform: translateX(50%);
      width: 130vw;
      height: 62svh;
      bottom: -4svh;
    }
    .hero__content {
