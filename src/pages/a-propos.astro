---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
import { photo } from '../lib/photos';

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Notre histoire', path: '/a-propos/' },
];

const values = [
  { icon: 'flame', title: 'La pâte, notre fierté', text: 'Pétrie chaque jour sur place, elle repose le temps qu’il faut pour être légère, moelleuse et croustillante.' },
  { icon: 'leaf', title: 'Des produits choisis', text: 'Mozzarella fondante, légumes frais, viandes et fromages sélectionnés : on ne transige pas sur la qualité.' },
  { icon: 'star', title: 'Des recettes pour tous', text: 'Des grands classiques aux créations gourmandes comme la Burger ou la Chilly, il y en a pour chaque envie.' },
  { icon: 'store', title: 'L’accueil avant tout', text: 'Sur place, à emporter ou en livraison, notre équipe vous reçoit avec le sourire. Happiness, ce n’est pas qu’un nom.' },
] as const;
---

<Base
  title="Notre histoire – pizzeria artisanale"
  description={`${SITE.name}, pizzeria artisanale à ${SITE.address.city} : pâte fraîche du jour, ingrédients soigneusement sélectionnés et recettes gourmandes.`}
  type="article"
  jsonLd={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Notre histoire"
    title="Une pizzeria de quartier,"
    titleAccent="une passion XXL."
    intro={`Chez ${SITE.name}, nous mettons tout notre savoir-faire et notre passion dans la création de pizzas délicieuses, préparées avec des ingrédients soigneusement sélectionnés.`}
    photo="ambiance-four"
  />

  <section class="sec--tight">
    <div class="wrap story">
      <div class="story__media rv">
        <Photo src={photo('ambiance-margherita')} alt="Pizza margherita au basilic frais" sizes="(min-width: 900px) 45vw, 100vw" class="story__img" />
      </div>
      <div class="story__txt">
        <p class="quote rv">
          « Que vous soyez amateur de <em>recettes classiques</em> ou en quête de <em class="grad">saveurs originales</em>, notre carte saura vous séduire. »
        </p>
        <p class="rv">
          Installée au cœur de {SITE.address.city}, au {SITE.address.street}, {SITE.name} est née d'une idée simple : proposer des pizzas artisanales au
          goût authentique, préparées chaque jour avec des ingrédients frais et de qualité, à des prix accessibles à tous.
        </p>
        <p class="rv">
          Chaque pizza est façonnée à la commande : la pâte est étalée à la main, garnie généreusement puis cuite jusqu'à ce que la croûte soit dorée et le
          fromage parfaitement fondu. Chez nous, chaque bouchée est une explosion de saveurs.
        </p>
        <div class="ctas rv">
          <a href="/carte/" class="btn btn-ember">Découvrir la carte <Icon name="arrow" stroke={2} /></a>
          <a href={telHref} class="btn btn-glass"><span class="dot"><Icon name="phone" /></span>{SITE.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec--tight">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Nos engagements</span>
          <h2 class="h2">Ce qui nous rend<em class="grad block">heureux.</em></h2>
        </div>
      </div>
      <ul class="values">
        {
          values.map((v, i) => (
            <li class="rv" style={`--d:${i}`}>
              <span class="values__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="values__ic">
                <Icon name={v.icon} />
              </span>
              <h3 class="h3">{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-hidden="true">
    <Photo src={photo('ambiance-fromage')} alt="" sizes="100vw" class="band__img" />
  </section>
</Base>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  .story__media {
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
  }
  .story__media :global(picture),
  .story__media :global(.story__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story__txt {
    display: grid;
    gap: 20px;
    color: var(--muted);
    font-size: 16.5px;
  }
  .quote {
    font: 700 clamp(26px, 3vw, 40px) / 1.1 var(--display);
    letter-spacing: -0.035em;
    color: var(--text);
  }
  .quote em {
    font: italic 400 1.1em/1 var(--serif);
  }
  .values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .values li {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 30px 26px;
    border-radius: 26px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--muted);
    font-size: 14.5px;
  }
  .values h3 {
    color: var(--text);
  }
  .values__n {
    position: absolute;
    top: 22px;
    right: 24px;
    font: italic 400 22px/1 var(--serif);
    color: var(--ember-2);
  }
  .values__ic {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: var(--grad-btn);
    color: #170903;
    margin-bottom: 8px;
  }
  .band {
    position: relative;
    height: clamp(260px, 40vw, 520px);
    overflow: hidden;
  }
  .band :global(picture),
  .band :global(.band__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--bg), transparent 30%, transparent 70%, #080605);
  }
  @media (max-width: 1000px) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
    .story {
      grid-template-columns: 1fr;
    }
    .story__media {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 560px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
