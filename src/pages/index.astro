<script>
  import { gsap, ScrollTrigger } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function webglAvailable() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  let scene: import('../scripts/pizza3d').PizzaScene | null = null;
  let progress = 0;

  // L'épinglage est créé tout de suite (pas de saut de mise en page), la 3D se branche ensuite.
  if (hero && !reduce) {
    const content = hero.querySelector('[data-hero-content]');
    const word = hero.querySelector('[data-hero-word]');
    const fallback = hero.querySelector('[data-hero-fallback]');
    gsap
      .timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: '+=110%',
          scrub: true,
          pin: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            progress = self.progress;
            scene?.setProgress(progress);
          },
        },
      })
      .to(content, { y: -120, opacity: 0, ease: 'none' }, 0.15)
      .to(word, { scale: 1.25, opacity: 0.3, ease: 'none' }, 0)
      .to(fallback, { scale: 1.2, rotate: 90, ease: 'none' }, 0);
    ScrollTrigger.refresh();
  }

  async function boot() {
    if (!hero || !canvas || !webglAvailable()) return;
    const { createPizzaScene } = await import('../scripts/pizza3d');
    scene = createPizzaScene(canvas);
    if (!scene) return;
    scene.setProgress(progress);
    document.documentElement.classList.add('has-webgl');
    if (!reduce) {
      window.addEventListener(
        'pointermove',
        (e) => scene?.setPointer((e.clientX / window.innerWidth) * 2 - 1, (e.clientY / window.innerHeight) * 2 - 1),
        { passive: true },
      );
    }
  }

  // on laisse le texte (LCP) s'afficher avant de charger la 3D
  if ('requestIdleCallback' in window) (window as any).requestIdleCallback(boot, { timeout: 1200 });
  else setTimeout(boot, 300);
</script>
