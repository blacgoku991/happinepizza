---
/**
 * En-tête des pages internes : photo d'ambiance plein cadre assombrie, fil d'Ariane, titre.
 */
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { photo as getPhoto } from '../lib/photos';

interface Props {
  crumbs: Array<{ name: string; path: string }>;
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  intro?: string;
  photo?: string;
  image?: ImageMetadata;
  compact?: boolean;
}
const { crumbs, eyebrow, title, titleAccent, intro, photo = 'ambiance-ardoise', image, compact = false } = Astro.props;
const bg = image ?? getPhoto(photo);
---

<section class:list={['phero', { 'phero--compact': compact }]}>
  <div class="phero__bg" aria-hidden="true">
    <Photo src={bg} alt="" sizes="100vw" priority class="phero__img" />
  </div>
  <div class="wrap phero__in">
    <nav aria-label="Fil d'Ariane" class="crumbs">
      <ol>
        {
          crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? (
                <>
                  <a href={c.path}>{c.name}</a>
                  <Icon name="arrow" size={13} />
                </>
              ) : (
                <span aria-current="page">{c.name}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="h2 phero__title">
      {title}
      {titleAccent && <em class="grad block">{titleAccent}</em>}
    </h1>
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: calc(var(--hdr) + clamp(48px, 8vw, 110px)) 0 clamp(64px, 8vw, 110px);
    min-height: min(78vh, 720px);
    display: flex;
    align-items: flex-end;
  }
  .phero--compact {
    min-height: 0;
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  .phero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .phero__bg :global(picture),
  .phero__bg :global(.phero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 8, 7, 0.94) 0%, rgba(10, 8, 7, 0.75) 38%, rgba(10, 8, 7, 0.3) 75%, rgba(10, 8, 7, 0.45) 100%),
      linear-gradient(180deg, rgba(10, 8, 7, 0.6) 0%, rgba(10, 8, 7, 0) 30%, rgba(10, 8, 7, 0.2) 70%, var(--bg) 100%);
  }
  .phero--compact .phero__bg::after {
    background: linear-gradient(180deg, rgba(10, 8, 7, 0.82), rgba(10, 8, 7, 0.9) 60%, var(--bg));
  }
  .phero__in {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .phero__title {
    max-width: 14ch;
  }
  .crumbs {
    margin-bottom: 26px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .crumbs a:hover,
  .crumbs [aria-current] {
    color: var(--text);
  }
</style>
