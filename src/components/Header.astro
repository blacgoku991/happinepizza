---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE, telHref } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${SITE.name} — accueil`}>
      <Logo size="sm" />
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={telHref} class="header-phone" aria-label={`Appeler ${SITE.name} au ${SITE.phone}`}>
        <span class="header-phone__icon"><Icon name="phone" size={18} /></span>
        <span class="header-phone__text">
          <small>Commander</small>
          <strong>{SITE.phone}</strong>
        </span>
      </a>
      <button class="cart-btn" type="button" data-cart-open aria-label="Ouvrir le panier">
        <Icon name="bag" size={22} />
        <span class="cart-btn__count" data-cart-count aria-live="polite">0</span>
      </button>
      <button class="burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu data-lenis-prevent hidden>
    <nav aria-label="Navigation mobile" class="container">
      <ul>
        <li><a href="/" class="mobile-menu__link"><span>00</span>Accueil</a></li>
        {
          NAV.map((item, i) => (
            <li>
              <a href={item.href} class="mobile-menu__link">
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__foot">
        <a href={telHref} class="btn btn--lg"><Icon name="phone" /> {SITE.phone}</a>
        <p class="muted">{SITE.address.street}, {SITE.address.city}</p>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s,
      box-shadow 0.4s;
  }
  .site-header.is-scrolled {
    background: rgba(18, 12, 10, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 1px 0 var(--line-dark);
  }
  .site-header.is-hidden:not(.menu-open) {
    transform: translateY(-100%);
  }
  /* backdrop-filter crée un bloc conteneur pour position:fixed : on le retire menu ouvert */
  .site-header.menu-open {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .site-nav ul {
    display: flex;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: rgba(255, 246, 234, 0.05);
    border: 1px solid var(--line-dark);
  }
  .site-nav__link {
    display: block;
    padding: 9px 16px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--muted-on-dark);
    transition:
      color 0.25s,
      background-color 0.25s;
  }
  .site-nav__link:hover {
    color: var(--cream);
    background: rgba(255, 246, 234, 0.06);
  }
  .site-nav__link.is-active {
    color: var(--ink);
    background: var(--cream);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .header-phone {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px 6px 6px;
    border-radius: 999px;
    background: var(--tomato);
    color: var(--cream);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s;
  }
  .header-phone:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }
  .header-phone__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    animation: ring 3s var(--ease-out) infinite;
  }
  @keyframes ring {
    0%,
    70%,
    100% {
      transform: rotate(0);
    }
    75% {
      transform: rotate(-14deg);
    }
    80% {
      transform: rotate(12deg);
    }
    85% {
      transform: rotate(-8deg);
    }
    90% {
      transform: rotate(4deg);
    }
  }
  .header-phone__text {
    display: grid;
    line-height: 1.05;
  }
  .header-phone__text small {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.85;
    font-weight: 700;
  }
  .header-phone__text strong {
    font-family: var(--font-display);
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }
  .cart-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 246, 234, 0.08);
    border: 1px solid var(--line-dark);
    transition:
      background-color 0.25s,
      transform 0.4s var(--ease-spring);
  }
  .cart-btn:hover {
    background: rgba(255, 246, 234, 0.14);
  }
  .cart-btn.bump {
    animation: bump 0.6s var(--ease-spring);
  }
  @keyframes bump {
    40% {
      transform: scale(1.25) rotate(-8deg);
    }
  }
  .cart-btn__count {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--saffron);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 800;
    transform: scale(0);
    transition: transform 0.4s var(--ease-spring);
  }
  .cart-btn__count.has-items {
    transform: scale(1);
  }
  .burger {
    display: none;
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--cream);
  }
  .burger span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.45s var(--ease-out);
  }
  .burger span:first-child {
    transform: translateY(-4px);
  }
  .burger span:last-child {
    transform: translateY(4px);
  }
  .menu-open .burger span:first-child {
    transform: rotate(45deg);
  }
  .menu-open .burger span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: 32px;
    background: var(--ink);
    overflow-y: auto;
    clip-path: circle(0 at calc(100% - 44px) 38px);
    transition: clip-path 0.8s var(--ease-out);
  }
  .menu-open .mobile-menu {
    clip-path: circle(150% at calc(100% - 44px) 38px);
  }
  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 10px 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 10vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    border-bottom: 1px solid var(--line-dark);
  }
  .mobile-menu__link span {
    font-size: 0.85rem;
    color: var(--tomato);
    letter-spacing: 0;
  }
  .mobile-menu__foot {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  @media (max-width: 1180px) {
    .site-nav__link {
      padding: 9px 12px;
    }
  }
  @media (max-width: 1060px) {
    .site-nav {
      display: none;
    }
    .burger {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .header-phone {
      padding: 6px;
    }
    .header-phone__text {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-mobile-menu]')!;

  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle('is-scrolled', y > 24);
    header.classList.toggle('is-hidden', y > 400 && y > lastY + 2);
    if (y < lastY - 2) header.classList.remove('is-hidden');
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.hidden = false;
    else setTimeout(() => !header.classList.contains('menu-open') && (menu.hidden = true), 800);
    window.dispatchEvent(new CustomEvent(open ? 'hp:lock' : 'hp:unlock'));
  };
  toggle.addEventListener('click', () => setOpen(!header.classList.contains('menu-open')));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('menu-open')) setOpen(false);
  });
</script>
