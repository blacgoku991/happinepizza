---
import { SIZES, BASES, TAGS, type Pizza } from '../data/menu';
import { SITE, formatPrice } from '../data/site';
import { pizzaArt } from '../lib/pizzaArt';
import Icon from './Icon.astro';

interface Props {
  pizza: Pizza;
  headingLevel?: 'h2' | 'h3';
  variant?: 'light' | 'dark';
}
const { pizza, headingLevel = 'h3', variant = 'light' } = Astro.props;
const H = headingLevel;
const href = `/pizzas/${pizza.slug}/`;
const excluded = SITE.offer.conditions.toLowerCase().includes(pizza.name.toLowerCase());
---

<article class:list={['pcard', `pcard--${variant}`]} data-filter-item data-base={pizza.base} data-tags={(pizza.tags ?? []).join(' ')} data-search={`${pizza.name} ${pizza.ingredients.join(' ')}`.toLowerCase()}>
  <a href={href} class="pcard__art" tabindex="-1" aria-hidden="true">
    <span class="pcard__plate"></span>
    <Fragment set:html={pizzaArt(pizza)} />
  </a>
  <div class="pcard__body">
    {
      pizza.tags && pizza.tags.length > 0 && (
        <ul class="pcard__tags">
          {pizza.tags.map((t) => (
            <li class={`tag tag--${TAGS[t].color}`}>{TAGS[t].label}</li>
          ))}
        </ul>
      )
    }
    <H class="pcard__name"><a href={href}>Pizza {pizza.name}</a></H>
    <p class="pcard__base">{BASES[pizza.base]}</p>
    <p class="pcard__ing">{pizza.ingredients.join(', ')}</p>
    <div class="pcard__sizes" role="group" aria-label={`Ajouter la pizza ${pizza.name} au panier`}>
      {
        SIZES.filter((s) => pizza.prices[s.key] != null).map((s) => (
          <button
            type="button"
            class="size-btn"
            data-add
            data-id={`${pizza.slug}:${s.key}`}
            data-name={`Pizza ${pizza.name}`}
            data-size-label={s.label}
            data-price={pizza.prices[s.key]}
            data-offer={s.key !== 'junior' && !excluded ? '1' : '0'}
            aria-label={`Ajouter ${pizza.name} ${s.label} à ${formatPrice(pizza.prices[s.key]!)}`}
          >
            <span class="size-btn__label">{s.label}</span>
            <span class="size-btn__price">{formatPrice(pizza.prices[s.key]!)}</span>
            <span class="size-btn__plus"><Icon name="plus" size={14} /></span>
          </button>
        ))
      }
    </div>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--text-on-light);
    box-shadow:
      0 1px 0 rgba(27, 19, 16, 0.04),
      0 30px 60px -40px rgba(60, 20, 0, 0.35);
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
    isolation: isolate;
  }
  .pcard:hover {
    transform: translateY(-6px);
    box-shadow:
      0 1px 0 rgba(27, 19, 16, 0.04),
      0 40px 80px -40px rgba(60, 20, 0, 0.5);
  }
  .pcard--dark {
    background: var(--ink-2);
    color: var(--text-on-dark);
    border: 1px solid var(--line-dark);
    box-shadow: none;
  }
  .pcard__art {
    position: relative;
    display: grid;
    place-items: center;
    padding: 28px 28px 8px;
  }
  .pcard__plate {
    position: absolute;
    inset: 18px 18px 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 55%, rgba(255, 180, 46, 0.28), transparent 65%);
    filter: blur(10px);
    opacity: 0.8;
    transition: opacity 0.5s;
  }
  .pcard__art :global(.pizza-art) {
    position: relative;
    width: min(100%, 260px);
    aspect-ratio: 1;
    filter: drop-shadow(0 18px 22px rgba(80, 30, 0, 0.35));
    transition: transform 1.1s var(--ease-out);
  }
  .pcard:hover .pcard__art :global(.pizza-art) {
    transform: rotate(35deg) scale(1.05);
  }
  .pcard__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 24px 24px;
  }
  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pcard__name {
    font-size: 1.6rem;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .pcard__name a:hover {
    color: var(--tomato-2);
  }
  .pcard__base {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tomato-2);
  }
  .pcard--dark .pcard__base {
    color: var(--saffron);
  }
  .pcard__ing {
    font-size: 0.93rem;
    color: var(--muted-on-light);
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .pcard--dark .pcard__ing {
    color: var(--muted-on-dark);
  }
  .pcard__sizes {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .size-btn {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 16px;
    background: var(--cream);
    border: 1.5px solid transparent;
    text-align: left;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      transform 0.3s var(--ease-spring);
  }
  .pcard--dark .size-btn {
    background: rgba(255, 246, 234, 0.06);
  }
  .size-btn:hover {
    border-color: var(--tomato);
    background: #fff1e6;
  }
  .pcard--dark .size-btn:hover {
    background: rgba(255, 77, 31, 0.14);
  }
  .size-btn:active {
    transform: scale(0.96);
  }
  .size-btn__label {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }
  .size-btn__price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .size-btn__plus {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--tomato);
    color: #fff;
    transition: transform 0.4s var(--ease-spring);
  }
  .size-btn:hover .size-btn__plus {
    transform: rotate(90deg) scale(1.1);
  }
  .size-btn:global(.is-added) .size-btn__plus {
    background: var(--basil);
    transform: scale(1.3);
  }
  @media (max-width: 380px) {
    .size-btn {
      padding: 10px 8px;
    }
    .size-btn__plus {
      display: none;
    }
  }
</style>
