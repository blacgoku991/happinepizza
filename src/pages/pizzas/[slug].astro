---
import Base from '../../layouts/Base.astro';
import PizzaCard from '../../components/PizzaCard.astro';
import OfferStrip from '../../components/OfferStrip.astro';
import Photo from '../../components/Photo.astro';
import { pizzaPhoto, photo } from '../../lib/photos';
import Icon from '../../components/Icon.astro';
import { PIZZAS, SIZES, BASES, TAGS, minPrice, type Pizza } from '../../data/menu';
import { SITE, telHref, formatPrice } from '../../data/site';
import { breadcrumbSchema, pizzaMenuItem } from '../../lib/schema';

export function getStaticPaths() {
  return PIZZAS.map((p) => ({ params: { slug: p.slug }, props: { pizza: p } }));
}

const { pizza } = Astro.props as { pizza: Pizza };
const city = SITE.address.city;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'La carte', path: '/carte/' },
  { name: 'Pizzas', path: '/carte/pizzas/' },
  { name: `Pizza ${pizza.name}`, path: `/pizzas/${pizza.slug}/` },
];
const def = pizza.prices.senior != null ? 'senior' : 'junior';
const fmt = (n: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: 2 });
const sizes = SIZES.filter((s) => pizza.prices[s.key] != null);
const excluded = SITE.offer.conditions.toLowerCase().includes(pizza.name.toLowerCase());

// Suggestions : même base en priorité, puis les autres
const related = [...PIZZAS.filter((p) => p.slug !== pizza.slug && p.base === pizza.base), ...PIZZAS.filter((p) => p.slug !== pizza.slug && p.base !== pizza.base)].slice(0, 3);
const idx = PIZZAS.findIndex((p) => p.slug === pizza.slug);
const prev = PIZZAS[(idx - 1 + PIZZAS.length) % PIZZAS.length];
const next = PIZZAS[(idx + 1) % PIZZAS.length];

const sizeList = sizes.map((s) => s.label).join(', ').replace(/, ([^,]*)$/, ' et $1');
const infoText = `Préparée à la commande sur notre pâte fraîche du jour, la pizza ${pizza.name} est disponible en taille ${sizeList}. Livraison gratuite à ${city} et dans un rayon de ${SITE.delivery.radiusKm} km, dès ${SITE.delivery.minOrder} € de commande.`;

const title = `Pizza ${pizza.name} à ${city}`;
// description ≤ 158 caractères : on retire des ingrédients si nécessaire
const tail = ` Dès ${formatPrice(minPrice(pizza))}, livrée à ${city} (${SITE.delivery.radiusKm} km offerts).`;
let ings = pizza.ingredients.filter((i) => !/origan/i.test(i));
let description = `Pizza ${pizza.name} : ${ings.join(', ').toLowerCase()}.${tail}`;
while (description.length > 158 && ings.length > 2) {
  ings = ings.slice(0, -1);
  description = `Pizza ${pizza.name} : ${ings.join(', ').toLowerCase()}…${tail}`;
}
---

<Base
  title={title}
  description={description}
  image={`/og/pizza-${pizza.slug}.jpg`}
  imageAlt={`Pizza ${pizza.name} — ${SITE.name}`}
  jsonLd={[breadcrumbSchema(crumbs), { '@context': 'https://schema.org', ...pizzaMenuItem(pizza) }]}
>
  <section class="pzh">
    <div class="pzh__bg" aria-hidden="true"><Photo src={photo('ambiance-ardoise')} alt="" sizes="100vw" class="pzh__bgimg" /></div>
    <div class="wrap pzh__grid">
      <div class="pzh__txt" data-pcard>
        <nav aria-label="Fil d'Ariane" class="crumbs">
          <ol>
            {
              crumbs.map((c, i) => (
                <li>
                  {i < crumbs.length - 1 ? (
                    <>
                      <a href={c.path}>{c.name}</a>
                      <Icon name="arrow" size={13} />
                    </>
                  ) : (
                    <span aria-current="page">{c.name}</span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <div class="pzh__tags">
          <span class="pill">{BASES[pizza.base]}</span>
          {pizza.tags?.map((t) => <span class:list={['pill', { 'pill--ember': t === 'best' || t === 'signature', 'pill--basil': t === 'vege' }]}>{TAGS[t].label}</span>)}
        </div>
        <h1 class="h1 pzh__title">Pizza <em class="grad">{pizza.name}</em></h1>
        <p class="lead">{pizza.pitch}</p>

        <h2 class="pzh__label">Ingrédients</h2>
        <ul class="pzh__ings">{pizza.ingredients.map((i) => <li>{i}</li>)}</ul>

        <h2 class="pzh__label">Choisissez votre taille</h2>
        <div class="sizes" role="radiogroup" aria-label="Taille">
          {
            sizes.map((s) => (
              <button
                type="button"
                role="radio"
                aria-checked={s.key === def ? 'true' : 'false'}
                class:list={{ on: s.key === def }}
                data-size={s.key}
                data-label={s.label}
                data-price={pizza.prices[s.key]}
                data-offer={s.key !== 'junior' && !excluded ? '1' : '0'}
              >
                <span>{s.label}</span>
                <b>{fmt(pizza.prices[s.key]!)} €</b>
              </button>
            ))
          }
        </div>
        <div class="ctas pzh__ctas">
          <button
            type="button"
            class="btn btn-ember add"
            data-add
            data-slug={pizza.slug}
            data-id={`${pizza.slug}:${def}`}
            data-name={`Pizza ${pizza.name}`}
            data-size-label={SIZES.find((s) => s.key === def)!.label}
            data-price={pizza.prices[def]}
            data-offer={def !== 'junior' && !excluded ? '1' : '0'}
          >
            <Icon name="plus" stroke={2.2} /> Ajouter · <span class="add__pr">{formatPrice(pizza.prices[def]!)}</span>
          </button>
          <a class="btn btn-glass" href={telHref}><span class="dot"><Icon name="phone" /></span>{SITE.phone}</a>
        </div>
      </div>

      <div class="plate" data-plate aria-hidden="true">
        <div class="plate__glow"></div>
        <div class="plate__disc" data-plate-disc>
          <Photo src={pizzaPhoto(pizza)} alt="" sizes="(min-width: 900px) 520px, 90vw" widths={[480, 640, 800, 1000]} priority class="plate__img" />
        </div>
        <span class="plate__price"><small>dès</small>{formatPrice(minPrice(pizza))}</span>
      </div>
    </div>
  </section>

  <section class="sec--tight">
    <div class="wrap info">
      <div>
        <span class="eyebrow">Tailles &amp; prix</span>
        <h2 class="h2">La {pizza.name},<em class="grad block">à votre faim.</em></h2>
        <p class="lead">{infoText}</p>
      </div>
      <table class="ptable">
        <caption class="sr-only">Prix de la pizza {pizza.name} selon la taille</caption>
        <thead><tr><th scope="col">Taille</th><th scope="col">Prix</th></tr></thead>
        <tbody>
          {sizes.map((s) => (
            <tr>
              <th scope="row">Pizza {pizza.name} <span>{s.label}</span></th>
              <td>{formatPrice(pizza.prices[s.key]!)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {!excluded && <div class="wrap"><OfferStrip /></div>}
  </section>

  <section class="sec--tight" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h2">Vous aimerez<em class="grad block">aussi.</em></h2>
        <a class="link-arrow" href="/carte/pizzas/">Toutes les pizzas <Icon name="arrow" /></a>
      </div>
      <ul class="grid-pizzas">{related.map((p) => <li><PizzaCard pizza={p} /></li>)}</ul>
      <nav class="pager" aria-label="Pizza précédente et suivante">
        <a href={`/pizzas/${prev.slug}/`} rel="prev"><span>← Précédente</span><strong>Pizza {prev.name}</strong></a>
        <a href={`/pizzas/${next.slug}/`} rel="next"><span>Suivante →</span><strong>Pizza {next.name}</strong></a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .pzh {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: calc(var(--hdr) + clamp(32px, 5vw, 64px)) 0 clamp(56px, 7vw, 100px);
  }
  .pzh__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
  }
  .pzh__bg :global(picture),
  .pzh__bg :global(.pzh__bgimg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(6px);
  }
  .pzh__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 75% 50%, rgba(255, 86, 24, 0.25), transparent 70%),
      linear-gradient(90deg, var(--bg) 0%, rgba(10, 8, 7, 0.85) 45%, rgba(10, 8, 7, 0.5) 100%),
      linear-gradient(180deg, transparent 60%, var(--bg));
  }
  .pzh__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .crumbs a:hover,
  .crumbs [aria-current] {
    color: var(--text);
  }
  .pzh__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 26px;
  }
  .pzh__title {
    margin-top: 22px;
    font-size: clamp(48px, 6.4vw, 96px);
  }
  .pzh__title em {
    display: block;
    font-size: 1.15em;
    line-height: 0.95;
  }
  .pzh__label {
    margin: 30px 0 12px;
    font: 700 11px/1 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .pzh__ings {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .pzh__ings li {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 240, 228, 0.04);
    font-size: 13.5px;
    font-weight: 600;
    color: #e1d5c9;
  }
  .sizes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 140px));
    gap: 6px;
  }
  .sizes button {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: 14px 16px;
    border-radius: 18px;
    border: 1px solid var(--line-2);
    background: rgba(255, 240, 228, 0.03);
    transition: background 0.3s, border-color 0.3s;
  }
  .sizes span {
    font: 700 10px/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .sizes b {
    font: 700 22px/1 var(--display);
    letter-spacing: -0.03em;
    color: #d7c9bc;
  }
  .sizes button:hover {
    border-color: rgba(255, 150, 90, 0.5);
  }
  .sizes button.on {
    background: linear-gradient(180deg, rgba(255, 130, 60, 0.2), rgba(255, 90, 31, 0.06));
    border-color: rgba(255, 140, 70, 0.6);
  }
  .sizes button.on span {
    color: var(--gold);
  }
  .sizes button.on b {
    color: #fff;
  }
  .pzh__ctas {
    margin-top: 26px;
  }

  .plate {
    position: relative;
    aspect-ratio: 1;
    perspective: 1400px;
  }
  .plate__glow {
    position: absolute;
    inset: -20%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 140, 60, 0.45), rgba(255, 86, 24, 0.15) 50%, transparent 75%);
  }
  .plate__disc {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 220, 190, 0.15),
      0 0 0 14px rgba(255, 240, 228, 0.03),
      0 60px 90px -30px rgba(0, 0, 0, 0.9);
    transform: rotateX(var(--tx, 18deg)) rotateZ(var(--tz, 0deg));
    will-change: transform;
  }
  .plate__disc :global(picture),
  .plate__disc :global(.plate__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plate__price {
    position: absolute;
    right: 2%;
    top: 8%;
    display: grid;
    padding: 14px 20px;
    border-radius: 20px;
    background: rgba(20, 14, 11, 0.6);
    border: 1px solid var(--line-2);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    font: 700 28px/1 var(--display);
    letter-spacing: -0.04em;
  }
  .plate__price small {
    font: italic 400 16px/1 var(--serif);
    color: var(--gold);
    margin-bottom: 4px;
  }

  .info {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: center;
  }
  .ptable {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .ptable th,
  .ptable td {
    padding: 18px 22px;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  .ptable thead th {
    font: 700 10.5px/1 var(--sans);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ptable tbody th {
    font-weight: 600;
  }
  .ptable tbody th span {
    color: var(--gold);
  }
  .ptable td {
    text-align: right;
    font: 700 22px/1 var(--display);
    letter-spacing: -0.03em;
  }
  .ptable tbody tr:last-child > * {
    border-bottom: 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 40px;
  }
  .pager a {
    display: grid;
    gap: 6px;
    padding: 20px 24px;
    border-radius: 22px;
    border: 1px solid var(--line);
    transition: border-color 0.3s, background 0.3s;
  }
  .pager a:hover {
    border-color: rgba(255, 140, 70, 0.45);
    background: rgba(255, 240, 228, 0.03);
  }
  .pager a[rel='next'] {
    text-align: right;
  }
  .pager span {
    font-size: 13px;
    color: var(--muted);
  }
  .pager strong {
    font: 700 20px/1.1 var(--display);
    letter-spacing: -0.02em;
  }
  @media (max-width: 900px) {
    .pzh__grid,
    .info {
      grid-template-columns: 1fr;
    }
    .plate {
      order: -1;
      width: min(100%, 420px);
      margin: 0 auto 10px;
    }
  }
  @media (max-width: 480px) {
    .sizes {
      grid-template-columns: repeat(3, 1fr);
    }
    .sizes button {
      padding: 12px;
    }
    .sizes b {
      font-size: 17px;
    }
  }
</style>

<script>
  // taille → bouton Ajouter
  document.querySelectorAll<HTMLElement>('[data-pcard]').forEach((box) => {
    const add = box.querySelector<HTMLButtonElement>('.add');
    if (!add || !box.classList.contains('pzh__txt')) return;
    const pr = add.querySelector('.add__pr')!;
    const btns = [...box.querySelectorAll<HTMLButtonElement>('.sizes button')];
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => {
          x.classList.toggle('on', x === b);
          x.setAttribute('aria-checked', String(x === b));
        });
        const price = Number(b.dataset.price);
        add.dataset.id = `${add.dataset.slug}:${b.dataset.size}`;
        add.dataset.sizeLabel = b.dataset.label;
        add.dataset.price = String(price);
        add.dataset.offer = b.dataset.offer;
        pr.textContent = price.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' €';
      }),
    );
  });
  // assiette 3D : rotation lente + redressement au scroll
  const disc = document.querySelector<HTMLElement>('[data-plate-disc]');
  if (disc && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const t0 = performance.now();
    const loop = (now: number) => {
      const p = Math.min(1, scrollY / (innerHeight * 0.8));
      disc.style.setProperty('--tx', `${18 + p * 34}deg`);
      disc.style.setProperty('--tz', `${((now - t0) / 1000) * 4 + p * 90}deg`);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
