---
/** Logo Happiness Pizza : arche de four à bois + flamme, wordmark Syne / Instrument Serif. */
interface Props {
  class?: string;
  sub?: boolean;
}
const { class: className, sub = true } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 7)}`;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <defs>
      <radialGradient id={`${id}e`} cx="50%" cy="88%" r="70%">
        <stop offset="0" stop-color="#FFE2B0"></stop><stop offset=".3" stop-color="#FF9A45"></stop>
        <stop offset=".62" stop-color="#FF4F14" stop-opacity=".75"></stop><stop offset="1" stop-color="#FF4F14" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`${id}f`} x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#FF5A1F"></stop><stop offset=".55" stop-color="#FFA24F"></stop><stop offset="1" stop-color="#FFE7BF"></stop>
      </linearGradient>
    </defs>
    <circle cx="20" cy="20" r="19.2" fill="none" stroke="rgba(246,239,231,.16)" stroke-width="1"></circle>
    <ellipse cx="20" cy="27.6" rx="8.4" ry="5.4" fill={`url(#${id}e)`}></ellipse>
    <path d="M20 19.6c2.3 2 3.3 3.8 3.3 5.3a3.3 3.3 0 0 1-6.6 0c0-.9.4-1.8 1.1-2.7.2.9.7 1.4 1.3 1.6-.3-1.4.1-2.8.9-4.2z" fill={`url(#${id}f)`}></path>
    <path d="M10.2 29.5V20.3a9.8 9.8 0 0 1 19.6 0v9.2" fill="none" stroke="#F6EFE7" stroke-width="1.7" stroke-linecap="round"></path>
    <path d="M6.8 29.5h26.4" stroke="#F6EFE7" stroke-width="1.7" stroke-linecap="round"></path>
  </svg>
  <span class="logo__txt">
    <span class="logo__word">Happiness<em>Pizza</em></span>
    {sub && <span class="logo__sub">Pizzeria artisanale</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .logo__mark {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .logo__txt {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__word {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .logo__word em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.22em;
    letter-spacing: -0.01em;
    margin-left: 3px;
    color: var(--ember-2);
  }
  .logo__sub {
    font: 600 8.5px/1 var(--sans);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 5px;
  }
  @media (max-width: 760px) {
    .logo__mark {
      width: 34px;
      height: 34px;
    }
    .logo__word {
      font-size: 17px;
    }
    .logo__sub {
      font-size: 7.5px;
      letter-spacing: 0.3em;
    }
  }
</style>
