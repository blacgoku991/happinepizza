---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import HoursPanel from '../components/HoursPanel.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';
import { FAQS } from '../data/faq';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const city = SITE.address.city;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Livraison', path: '/livraison/' },
];
const faqs = FAQS.filter((f) => /livr|command|paiement|emporter/i.test(f.q));

const deliverySchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Livraison de pizzas à domicile',
  provider: { '@id': `${SITE.url}/#restaurant` },
  areaServed: SITE.zones.map((z) => ({ '@type': 'City', name: z })),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: `Livraison gratuite dans un rayon de ${SITE.delivery.radiusKm} km, minimum de commande ${SITE.delivery.minOrder} €`,
  },
};
---

<Base
  title={`Livraison de pizzas à ${city}`}
  description={`Livraison de pizzas gratuite à ${city}, ${SITE.zones.slice(1, 3).join(', ')}… dans un rayon de ${SITE.delivery.radiusKm} km. Minimum ${SITE.delivery.minOrder} €. ☎ ${SITE.phone}`}
  jsonLd={[breadcrumbSchema(crumbs), deliverySchema, faqSchema(faqs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Livraison"
    title="Vos pizzas livrées"
    titleAccent="bien chaudes."
    intro={`Livraison gratuite à ${city} et dans les communes voisines, dans un rayon de ${SITE.delivery.radiusKm} km, dès ${SITE.delivery.minOrder} € de commande.`}
    photo="ambiance-mains"
  >
    <div class="ctas">
      <a href={telHref} class="btn btn-ember"><Icon name="phone" stroke={2} /> {SITE.phone}</a>
      <a href="/carte/" class="btn btn-glass">Voir la carte <Icon name="arrow" /></a>
    </div>
  </PageHero>

  <section class="sec--tight">
    <div class="wrap">
      <ul class="kpis">
        <li class="rv"><span class="ic"><Icon name="scooter" /></span><b>Gratuite</b><span>dans un rayon de {SITE.delivery.radiusKm} km</span></li>
        <li class="rv" style="--d:1"><span class="ic"><Icon name="euro" /></span><b>{SITE.delivery.minOrder} €</b><span>minimum de commande</span></li>
        <li class="rv" style="--d:2"><span class="ic"><Icon name="clock" /></span><b>7j/7</b><span>midi et soir</span></li>
        <li class="rv" style="--d:3"><span class="ic"><Icon name="card" /></span><b>CB · Espèces</b><span>titres-restaurant acceptés</span></li>
      </ul>

      <div class="zones">
        <div>
          <span class="eyebrow">Communes livrées</span>
          <h2 class="h2">Nous livrons<em class="grad block">près de chez vous.</em></h2>
          <p class="lead">
            Depuis notre pizzeria du {SITE.address.street}, nous livrons {city} et les villes voisines. Votre commune n'apparaît pas&nbsp;?
            Appelez-nous au <a href={telHref}>{SITE.phone}</a>.
          </p>
        </div>
        <ul class="towns">
          {
            SITE.zones.map((z, i) => (
              <li class:list={['rv', { me: i === 0 }]} style={`--d:${i % 4}`}>
                <h3>Livraison pizza {z}</h3>
                <p>{i === 0 ? 'Notre ville — livraison express' : `Livraison gratuite depuis ${city}`}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec--tight">
    <div class="wrap bottom">
      <div class="rv"><HoursPanel /></div>
      <div>
        <span class="eyebrow">Bon à savoir</span>
        <h2 class="h2 bottom__t">Questions<em class="grad block">fréquentes.</em></h2>
        <Faq items={faqs} />
      </div>
    </div>
  </section>
</Base>

<style>
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .kpis li {
    display: grid;
    gap: 6px;
    padding: 26px 24px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .kpis .ic {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: var(--ember-2);
    background: rgba(255, 90, 31, 0.08);
    border: 1px solid rgba(255, 130, 60, 0.2);
    margin-bottom: 10px;
  }
  .kpis b {
    font: 700 26px/1 var(--display);
    letter-spacing: -0.03em;
  }
  .kpis li > span:last-child {
    color: var(--muted);
    font-size: 14px;
  }
  .zones {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(64px, 8vw, 110px);
  }
  .zones a {
    color: var(--gold);
    font-weight: 700;
  }
  .towns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .towns li {
    padding: 18px 20px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: rgba(255, 240, 228, 0.025);
  }
  .towns li.me {
    border-color: rgba(255, 140, 70, 0.45);
    background: linear-gradient(135deg, rgba(255, 120, 50, 0.16), rgba(255, 90, 31, 0.03));
  }
  .towns h3 {
    font: 700 16px/1.25 var(--display);
    letter-spacing: -0.02em;
  }
  .towns p {
    margin-top: 4px;
    font-size: 13px;
    color: var(--muted);
  }
  .bottom {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .bottom__t {
    margin-bottom: 28px;
  }
  @media (max-width: 1000px) {
    .kpis {
      grid-template-columns: repeat(2, 1fr);
    }
    .zones,
    .bottom {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .towns {
      grid-template-columns: 1fr;
    }
    .kpis {
      gap: 10px;
    }
    .kpis li {
      padding: 18px 16px;
    }
    .kpis b {
      font-size: 20px;
    }
  }
</style>
