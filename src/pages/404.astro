---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, telHref } from '../data/site';
import { cutout } from '../lib/photos';
const img = (await getImage({ src: cutout('ardoise')!, width: 700, format: 'webp', quality: 80 })).src;
---

<Base title="Page introuvable" description={`Cette page n'existe pas ou plus. Retrouvez toute la carte ${SITE.name}, pizzeria à ${SITE.address.city}.`} noindex>
  <section class="nf">
    <div class="wrap nf__in">
      <div class="nf__big" aria-hidden="true">
        <span>4</span><img src={img} alt="" width="700" height="700" /><span>4</span>
      </div>
      <h1 class="h2">Oups, cette part <em class="grad">a disparu.</em></h1>
      <p class="lead">La page que vous cherchez n'existe pas ou a été déplacée. Mais la carte, elle, est bien là.</p>
      <div class="ctas">
        <a href="/carte/" class="btn btn-ember">Voir la carte <Icon name="arrow" stroke={2} /></a>
        <a href={telHref} class="btn btn-glass"><span class="dot"><Icon name="phone" /></span>{SITE.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: var(--hdr);
    background: radial-gradient(60% 50% at 50% 40%, rgba(255, 86, 24, 0.18), transparent 70%);
  }
  .nf__in {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: 60px;
  }
  .nf__big {
    display: flex;
    align-items: center;
    font: 800 clamp(8rem, 26vw, 17rem) / 0.8 var(--display);
    letter-spacing: -0.06em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf__big img {
    width: 0.85em;
    height: 0.85em;
    margin: 0 0.02em;
    clip-path: circle(49%);
    transform: perspective(700px) rotateX(40deg);
    animation: nfspin 14s linear infinite;
  }
  @keyframes nfspin {
    to {
      rotate: 360deg;
    }
  }
  .nf .lead {
    margin-inline: auto;
  }
  .nf .ctas {
    justify-content: center;
  }
</style>
