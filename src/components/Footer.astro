---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, NAV, telHref, mapsUrl } from '../data/site';
import { ALL_CATEGORIES, PIZZAS } from '../data/menu';

const socials = Object.entries(SITE.social).filter(([, u]) => u) as Array<['instagram' | 'facebook' | 'tiktok' | 'google', string]>;
const fmt = (t: string) => t.replace(':', 'h');
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a href="/" aria-label={`${SITE.name} — accueil`}><Logo /></a>
        <p>Pizzas artisanales, pâtes et desserts à {SITE.address.city}. Livraison, à emporter et sur place, 7 jours sur 7.</p>
        <a class="btn btn-ember btn-sm" href={telHref}><Icon name="phone" size={17} stroke={2} /> {SITE.phone}</a>
        {
          socials.length > 0 && (
            <ul class="ftr__social">
              {socials.map(([n, u]) => (
                <li>
                  <a href={u} target="_blank" rel="noopener me" aria-label={n}>
                    <Icon name={n === 'google' ? 'star' : n} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div>
        <h2 class="ftr__h">La carte</h2>
        <ul>{ALL_CATEGORIES.map((c) => <li><a href={`/carte/${c.slug}/`}>{c.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="ftr__h">Nos pizzas</h2>
        <ul>{PIZZAS.slice(0, 7).map((p) => <li><a href={`/pizzas/${p.slug}/`}>Pizza {p.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="ftr__h">Horaires</h2>
        <ul class="ftr__hours">
          {
            SITE.hours.map((d) => (
              <li>
                <span>{d.day}</span>
                <span>{d.slots.length ? d.slots.map(([a, b]) => `${fmt(a)}–${fmt(b)}`).join(' · ') : 'Fermé'}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="ftr__h">Nous trouver</h2>
        <address>
          <a href={mapsUrl} target="_blank" rel="noopener">{SITE.address.street}<br />{SITE.address.postalCode} {SITE.address.city}</a>
        </address>
        <ul class="ftr__links">
          {NAV.filter((n) => !n.href.startsWith('/carte')).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="ftr__bot">
      <span>© {new Date().getFullYear()} {SITE.name} · {SITE.legal.rcs} {SITE.legal.siren}</span>
      <nav aria-label="Informations légales">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/mentions-legales/#confidentialite">Confidentialité</a>
        <a href="/sitemap-index.xml">Plan du site</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    background: #080605;
    border-top: 1px solid rgba(255, 150, 90, 0.18);
    padding: 72px 0 30px;
  }
  .ftr::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 12%;
    right: 12%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 150, 80, 0.95), transparent);
    box-shadow: 0 0 36px 6px rgba(255, 90, 31, 0.45);
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.1fr 1fr;
    gap: 40px;
  }
  .ftr__brand {
    display: grid;
    gap: 18px;
    align-content: start;
    justify-items: start;
  }
  .ftr__brand p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 320px;
  }
  .ftr__h {
    margin: 6px 0 16px;
    font: 700 10.5px/1 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .ftr ul {
    display: grid;
    gap: 10px;
    font-size: 14.5px;
    color: #d8cbbe;
  }
  .ftr ul a,
  address a {
    transition: color 0.3s;
  }
  .ftr ul a:hover,
  address a:hover {
    color: var(--ember-2);
  }
  address {
    font-style: normal;
    font-size: 14.5px;
    line-height: 1.6;
    color: #d8cbbe;
  }
  .ftr__links {
    margin-top: 18px;
  }
  .ftr__hours {
    font-size: 13px !important;
    gap: 7px !important;
  }
  .ftr__hours li {
    display: grid;
  }
  .ftr__hours span:first-child {
    font-weight: 700;
    color: var(--text);
  }
  .ftr__hours span:last-child {
    color: var(--muted);
  }
  .ftr__social {
    display: flex !important;
    gap: 8px;
  }
  .ftr__social a {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    display: grid;
    place-items: center;
  }
  .ftr__bot {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: var(--dim);
  }
  .ftr__bot nav {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }
  .ftr__bot a:hover {
    color: var(--text);
  }
  @media (max-width: 1180px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }
  }
</style>
